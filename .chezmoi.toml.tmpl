{{/* boolean feature tags */}}
{{- $ephemeral := false -}}{{/* true if this machine is ephemeral, e.g. a cloud or VM instance */}}
{{- $work := false -}}{{/* true if this machine is a work machine */}}
{{- $laptop := false -}}{{/* true if this machine is a laptop*/}}
{{- $headless := false -}}{{/* true if this machine does not have a screen and keyboard */}}
{{- $personal := false -}}{{/* true if this machine should have personal secrets */}}
{{- "" -}}

{{- $osID := .chezmoi.os -}}
{{- if (and (eq .chezmoi.os "linux") (hasKey .chezmoi.osRelease "id")) -}}
{{-   $osID = printf "%s-%s" .chezmoi.os .chezmoi.osRelease.id -}}
{{- end -}}

{{/* detect GitHub codespaces, VSCode remote containers, Docker containers, Multipass VMs, and Vagrant boxes */}}
{{- if or (env "CODESPACES") (env "REMOTE_CONTAINERS_IPC") (eq .chezmoi.username "root" "ubuntu" "vagrant" "vscode") -}}
{{-   $ephemeral = true -}}
{{-   $headless = true -}}
{{- end -}}

{{/* work around unreliable hostname on darwin */}}
{{- $hostname := .chezmoi.hostname -}}
{{- if eq .chezmoi.os "darwin" -}}
{{-   $hostname := output "scutil" "--get" "LocalHostName" | trim -}}
{{- end -}}

{{- if eq .chezmoi.os "windows" -}}
{{-   $ephemeral = true -}}
{{- end -}}

{{- $ghProjectOwner := "" -}}
{{- $ghProjectNumber := "" -}}
{{- $ghUsername := "" -}}

{{- if and (not $ephemeral) (stdinIsATTY) -}}
{{-   $ephemeral = promptBoolOnce . "ephemeral" "ephemeral" -}}
{{-   $headless = promptBoolOnce . "headless" "headless" -}}
{{-   $personal = promptBoolOnce . "personal" "personal machine" -}}
{{-   $work = promptBoolOnce . "work" "work machine" -}}
{{-   $laptop = promptBoolOnce . "laptop" "laptop" -}}
{{- else if and (not $ephemeral) (not (stdinIsATTY)) -}}
{{-   $ephemeral = true -}}
{{-   $headless = true -}}
{{- end -}}

{{- if $work -}}
{{-   if stdinIsATTY -}}
{{-     $ghProjectOwner = promptStringOnce . "ghProjectOwner" "GitHub project owner (org)" -}}
{{-     $ghProjectNumber = promptStringOnce . "ghProjectNumber" "GitHub project number" -}}
{{-     $ghUsername = promptStringOnce . "ghUsername" "GitHub username" -}}
{{-   end -}}
{{- end -}}

{{- $email := "niklas.herder@gmail.com" -}}
{{- $name := promptStringOnce . "name" "Full name (for git etc.)" "Niklas Herder" -}}

[data]
    ephemeral = {{ $ephemeral }}
    email = {{ $email | quote }}
    name = {{ $name | quote }}
    work = {{ $work }}
    headless = {{ $headless }}
    hostname = {{ $hostname | quote }}
    laptop = {{ $laptop }}
    personal = {{ $personal }}
    osid = {{ $osID | quote }}
    kubectlVersion = "v1.33.3"
    ghProjectOwner = {{ $ghProjectOwner | quote }}
    ghProjectNumber = {{ $ghProjectNumber | quote }}
    ghUsername = {{ $ghUsername | quote }}

[github]
    refreshPeriod = "12h"
    accessToken = {{ onepasswordRead "op://Private/GH CLI/token" "my.1password.eu" | quote }}
[merge]
    command = "nvim"
    args = [
        "-d",
        {{ printf "%q" "{{ .Destination }}" }},
        {{ printf "%q" "{{ .Source }}" }},
        {{ printf "%q" "{{ .Target }}" }},
    ]


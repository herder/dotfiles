{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local)",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "devstral:24b-32k": {
          "name": "Devstral 24B",
          "tools": true
        },
        "gemma3:1b": {
          "name": "Gemma 3 1B (fast)"
        }
      }
    },
    "flm": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "FastFlowLM (Ryzen AI NPU)",
      "options": {
        "baseURL": "http://localhost:52625/v1"
      },
      "models": {
        "gpt-oss:20b": {
          "name": "gpt-oss 20B (NPU)",
          "tools": true
        },
        "qwen3-4b": {
          "name": "Qwen3 4B (NPU)",
          "tools": true
        },
        "gemma3:1b": {
          "name": "Gemma 3 1B (NPU, fast)"
        }
      }
    }
  }
}

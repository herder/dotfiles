# Machine-wide packages: what needs root, system integration, or has no prebuilt
# release. CLIs and toolchains are [tools] in ../config.toml. Applied by
# .chezmoiscripts/run_onchange_after_00-mise-install before `mise install`.
[bootstrap.packages]
{{- if eq .osid "linux-arch" }}
"pacman:android-tools" = "latest"
"pacman:atool" = "latest"
"pacman:cups" = "latest"
"pacman:cups-pdf" = "latest"
"pacman:deluge-gtk" = "latest"
"pacman:docker" = "latest"
"pacman:docker-compose" = "latest"
"pacman:firefox" = "latest"
"pacman:git" = "latest"
"pacman:harfbuzz" = "latest"
"pacman:networkmanager" = "latest"
"pacman:netstat" = "latest"
"pacman:nfs-utils" = "latest"
"pacman:openssh" = "latest"
"pacman:system-config-printer" = "latest"
"pacman:systemd-resolvconf" = "latest"
"pacman:tailscale" = "latest"
"pacman:tig" = "latest"
"pacman:ttf-jetbrains-mono-nerd" = "latest"
"pacman:ttf-nerd-fonts-symbols" = "latest"
"pacman:unzip" = "latest"
"pacman:yakuake" = "latest"
"pacman:zip" = "latest"
"pacman:whois" = "latest"
"aur:autofs" = "latest"
"aur:binsider" = "latest"
"aur:coolercontrol" = "latest"
"aur:discord" = "latest"
"aur:jetbrains-toolbox" = "latest"
"aur:keybase-bin" = "latest"
"aur:moonlight-qt" = "latest"
"aur:moreutils" = "latest"
"aur:sshrc" = "latest"
"aur:sunshine" = "latest"
{{- else if eq .osid "linux-pop" }}
"apt:1password" = "latest"
"apt:1password-cli" = "latest"
"apt:adb" = "latest"
"apt:at" = "latest"
"apt:atool" = "latest"
"apt:autofs" = "latest"
# toolchain: stock Pop!_OS ships no compiler; rustup, keyd and the COSMIC applet
# builds (libcosmic needs xkbcommon + wayland headers) all assume one
"apt:build-essential" = "latest"
"apt:pkg-config" = "latest"
"apt:libxkbcommon-dev" = "latest"
"apt:libwayland-dev" = "latest"
# kdeconnect applet: libdbus-sys, libpulse-sys, drm-sys
"apt:libdbus-1-dev" = "latest"
"apt:libpulse-dev" = "latest"
"apt:libdrm-dev" = "latest"
"apt:git" = "latest"
"apt:unzip" = "latest"
"apt:cmake" = "latest"
"apt:ddcutil" = "latest"
"apt:docker.io" = "latest"
"apt:docker-compose-v2" = "latest"
"apt:entr" = "latest"
"apt:ffmpeg" = "latest"
"apt:fprintd" = "latest"
"apt:git-lfs" = "latest"
"apt:htop" = "latest"
"apt:ldnsutils" = "latest"
"apt:libpam-fprintd" = "latest"
"apt:libpam-u2f" = "latest"
"apt:libpcsclite-dev" = "latest"
"apt:libssl-dev" = "latest"
"apt:lsp-plugins-ladspa" = "latest"
"apt:lutris" = "latest"
"apt:neofetch" = "latest"
"apt:postgresql-client-common" = "latest"
"apt:sqlfluff" = "latest"
"apt:steam" = "latest"
"apt:tig" = "latest"
"apt:tlp" = "latest"
"apt:tldr-hs" = "latest"
"apt:tmux" = "latest"
"apt:torbrowser-launcher" = "latest"
"apt:urlscan" = "latest"
"apt:whois" = "latest"
"apt:wl-clipboard" = "latest"
"apt:uuid-runtime" = "latest"
"apt:yubikey-luks" = "latest"
"apt:yubikey-manager" = "latest"
"apt:zsh" = "latest"
{{- else if eq .osid "darwin" }}
"brew:android-platform-tools" = "latest"
"brew:atool" = "latest"
"brew:cmake" = "latest"
"brew:entr" = "latest"
"brew:ffmpeg" = "latest"
"brew:git" = "latest"
"brew:git-lfs" = "latest"
"brew:htop" = "latest"
"brew:libpq" = "latest"
"brew:tig" = "latest"
"brew:tldr" = "latest"
"brew:tmux" = "latest"
"brew-cask:1password" = "latest"
"brew-cask:1password-cli" = "latest"
"brew-cask:docker" = "latest"
"brew-cask:slack" = "latest"
"brew-cask:steam" = "latest"
"brew-cask:tor-browser" = "latest"
{{- end }}

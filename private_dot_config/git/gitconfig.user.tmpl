[user]
  name = Niklas Herder
  email = {{ .email }}
  useConfigOnly = true
  signingkey = {{ onepasswordRead "op://Private/Privat SSH/public key" .opAccount }}
[gpg]
  format = ssh
[gpg "ssh"]
  program = "/opt/1Password/op-ssh-sign"
[commit]
  gpgsign = true
[fetch]
  prune = true
[init]
  defaultBranch = main
[pull]
  rebase = true
[rebase]
  autoStash = true
[core]
  filemode = true
[include]
  path = ~/.config/git/gitconfig.diff
{{- if .work }}

# Work email applies only to repos under ~/src/git/github.com/Stravito/ (covers
# both main checkouts and worktrees, since worktrees live under .../Stravito/worktrees/).
# Everywhere else falls back to the personal email set above.
[includeIf "gitdir:~/src/git/github.com/Stravito/"]
  path = ~/.config/git/gitconfig.work
{{- end }}


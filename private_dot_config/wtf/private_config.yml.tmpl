wtf:
  colors:
    border:
      focusable: darkslateblue
      focused: orange
      normal: gray
  grid:
    # Designed for half-screen terminal (~120 cols)
    columns: [50, 50]
    rows: [7, 13, 13, 13, 10]
  refreshInterval: 1
  mods:
    clocks:
      colors:
        rows:
          even: "lightblue"
          odd: "white"
      enabled: true
      locations:
        Stockholm: "Europe/Stockholm"
        New York: "America/New_York"
      position:
        top: 0
        left: 0
        height: 1
        width: 1
      refreshInterval: 15
      sort: "alphabetical"
      title: "Clocks"
      type: clocks
    prettyweather:
      enabled: true
      city: "Sundbyberg"
      position:
        top: 0
        left: 1
        height: 1
        width: 1
      refreshInterval: 900
      unit: "m"
      view: 0
      language: "en"
    work:
      cmd: "{{ .chezmoi.homeDir }}/.local/bin/task-dashboard"
      enabled: true
      position:
        top: 1
        left: 0
        height: 2
        width: 2
      refreshInterval: 120
      title: "Work"
      type: cmdrunner
      focusable: true
      focusChar: "w"
    calendar:
      args: ["agenda", "--nostarted", "--nodeclined", "--details=length", "--details=location"]
      cmd: "gcalcli"
      enabled: true
      position:
        top: 3
        left: 0
        height: 1
        width: 2
      refreshInterval: 300
      title: "Calendar"
      type: cmdrunner
      focusable: true
      focusChar: "c"
    tasks:
      args: ["today"]
      cmd: "{{ .chezmoi.homeDir }}/.local/bin/task-list"
      enabled: true
      position:
        top: 4
        left: 0
        height: 1
        width: 2
      refreshInterval: 60
      title: "Today"
      type: cmdrunner
      focusable: true
      focusChar: "t"

{{- $home := .chezmoi.homeDir -}}
# Applied by .chezmoiscripts/linux/run_onchange_after_syncthing.sh.tmpl, which
# also pins it to the tailnet. Shared folders come from .chezmoidata/syncthing.yaml.
services:
  syncthing:
    image: syncthing/syncthing:2
    container_name: syncthing
    hostname: {{ .chezmoi.hostname }}
    # Host networking so it can bind the tailscale IP directly.
    network_mode: host
    environment:
      PUID: "{{ .chezmoi.uid }}"
      PGID: "{{ .chezmoi.gid }}"
      STGUIADDRESS: 127.0.0.1:8384
    volumes:
      - {{ $home }}/.local/state/syncthing:/var/syncthing/config
      - {{ $home }}/Sync:{{ $home }}/Sync
{{- range .syncthing.folders }}
      - {{ $home }}/{{ .path }}:{{ $home }}/{{ .path }}
{{- end }}
    restart: unless-stopped
    healthcheck:
      test: curl -fkLsS -m 2 127.0.0.1:8384/rest/noauth/health | grep -q OK
      interval: 1m
      timeout: 10s
      retries: 3
      start_period: 30s
      start_interval: 2s

# -- general -------------------------------------------------------------------

set -g default-terminal "tmux-256color"
set -as terminal-features ",*:RGB"
set -s escape-time 10
set -sg repeat-time 600
set -g history-limit 5000
set -g mouse on
set -g focus-events on
set -g status-position top
set -g status-interval 2
set -g detach-on-destroy off

# prefix
set -g prefix C-'\'
bind C-'\' send-prefix

# -- display -------------------------------------------------------------------

# start windows and panes at 1
set -g base-index 1
setw -g pane-base-index 1
set -g renumber-windows on

# frosted glass: default bg lets the compositor blur show through both panes
# (an explicit bg=colour is opaque and paints over the transparency)
# set -g window-style "bg=#{@thm_crust}"
set -g window-style "bg=default"
set -g window-active-style "bg=default"

# -- navigation ----------------------------------------------------------------

# new panes/windows retain current path
bind '"' split-window -v -c "#{pane_current_path}"
bind '%' split-window -h -c "#{pane_current_path}"
bind '-' split-window -v -c "#{pane_current_path}"
bind '_' split-window -h -c "#{pane_current_path}"

# Smart pane switching with awareness of Vim splits
# See: https://github.com/christoomey/vim-tmux-navigator
is_vim="ps -o state= -o comm= -t '#{pane_tty}' \
    | grep -iqE '^[^TXZ ]+ +(\\S+\\/)?g?(view|l?n?vim?x?|fzf)(diff)?$'"
bind-key -n 'C-h' if-shell "$is_vim" 'send-keys C-h'  'select-pane -L'
bind-key -n 'C-j' if-shell "$is_vim" 'send-keys C-j'  'select-pane -D'
bind-key -n 'C-k' if-shell "$is_vim" 'send-keys C-k'  'select-pane -U'
bind-key -n 'C-l' if-shell "$is_vim" 'send-keys C-l'  'select-pane -R'
bind-key -n 'C-\' if-shell "$is_vim" 'send-keys C-\\\\'  'select-pane -l'
bind-key -T copy-mode-vi 'C-h' select-pane -L
bind-key -T copy-mode-vi 'C-j' select-pane -D
bind-key -T copy-mode-vi 'C-k' select-pane -U
bind-key -T copy-mode-vi 'C-l' select-pane -R
bind-key -T copy-mode-vi 'C-\' select-pane -l

# resize panes (repeatable within repeat-time)
bind -r H resize-pane -L 5
bind -r J resize-pane -D 5
bind -r K resize-pane -U 5
bind -r L resize-pane -R 5

# -- copy mode -----------------------------------------------------------------

setw -g mode-keys vi
set -s copy-command 'wl-copy'
set -s set-clipboard on
bind-key -T copy-mode-vi v send-keys -X begin-selection
bind-key -T copy-mode-vi y send-keys -X copy-pipe-and-cancel

# -- Kanagawa theme (catppuccin variable mapping) ------------------------------

set -g @thm_bg "#1F1F28"          # sumiInk3
set -g @thm_fg "#DCD7BA"          # fujiWhite
set -g @thm_crust "#16161D"       # sumiInk0
set -g @thm_mantle "#1a1a22"      # sumiInk2
set -g @thm_surface_0 "#2A2A37"   # sumiInk4
set -g @thm_surface_1 "#363646"   # sumiInk5
set -g @thm_surface_2 "#54546D"   # sumiInk6
set -g @thm_overlay_0 "#727169"   # fujiGray
set -g @thm_overlay_1 "#938AA9"   # springViolet1
set -g @thm_overlay_2 "#C8C093"   # oldWhite
set -g @thm_subtext_0 "#C8C093"   # oldWhite
set -g @thm_subtext_1 "#DCD7BA"   # fujiWhite
set -g @thm_blue "#7E9CD8"        # crystalBlue
set -g @thm_lavender "#7FB4CA"    # springBlue
set -g @thm_sapphire "#658594"    # dragonBlue
set -g @thm_sky "#A3D4D5"         # lightBlue
set -g @thm_teal "#7AA89F"        # waveAqua2
set -g @thm_green "#98BB6C"       # springGreen
set -g @thm_yellow "#E6C384"      # carpYellow
set -g @thm_peach "#FFA066"       # surimiOrange
set -g @thm_maroon "#E46876"      # waveRed
set -g @thm_red "#FF5D62"         # peachRed
set -g @thm_mauve "#957FB8"       # oniViolet
set -g @thm_pink "#D27E99"        # sakuraPink
set -g @thm_flamingo "#DCA561"    # autumnYellow
set -g @thm_rosewater "#C0A36E"   # boatYellow2

# -- catppuccin ----------------------------------------------------------------

set -g @catppuccin_flavor "mocha"

# window status
set -g @catppuccin_window_status_style "rounded"
set -g @catppuccin_window_text " #W"
set -g @catppuccin_window_number "#I"
set -g @catppuccin_window_current_text " #W"
set -g @catppuccin_window_current_number "#I"
set -g @catppuccin_window_current_number_color "#{@thm_mauve}"
set -g @catppuccin_window_flags "icon"

# pane borders: dim inactive, loud active (peach border + arrows + title pill)
set -g @catppuccin_pane_border_style "fg=#{@thm_surface_2}"
set -g @catppuccin_pane_active_border_style "fg=#{@thm_peach}"
set -g pane-border-status top
set -g pane-border-indicators both
set -g pane-border-format "#{?pane_active,#[fg=#{@thm_crust}#,bg=#{@thm_peach}#,bold]  #{?pane_title,#{pane_title},#{pane_current_command}}  #[default],}"

# status bar
set -g @catppuccin_status_background "default"
set -g @catppuccin_status_left_separator ""
set -g @catppuccin_status_right_separator ""
set -g @catppuccin_status_connect_separator "no"

# module styles: dark pills with colored icon glyphs
set -g @catppuccin_status_session_icon_fg "#98BB6C"
set -g @catppuccin_status_session_icon_bg "#2A2A37"
set -g @catppuccin_status_session_text_fg "#DCD7BA"
set -g @catppuccin_status_uptime_icon_fg "#658594"
set -g @catppuccin_status_uptime_icon_bg "#2A2A37"
set -g @catppuccin_status_uptime_text_fg "#DCD7BA"
set -g @catppuccin_status_battery_icon_fg "#7FB4CA"
set -g @catppuccin_status_battery_icon_bg "#2A2A37"
set -g @catppuccin_status_battery_text_fg "#DCD7BA"
set -g @catppuccin_status_date_time_icon_fg "#7E9CD8"
set -g @catppuccin_status_date_time_icon_bg "#2A2A37"
set -g @catppuccin_status_date_time_text_fg "#DCD7BA"
set -g @catppuccin_status_user_icon_fg "#A3D4D5"
set -g @catppuccin_status_user_icon_bg "#2A2A37"
set -g @catppuccin_status_user_text_fg "#DCD7BA"
set -g @catppuccin_status_host_icon_fg "#957FB8"
set -g @catppuccin_status_host_icon_bg "#2A2A37"
set -g @catppuccin_status_host_text_fg "#DCD7BA"

# icon padding
set -g @catppuccin_session_icon " #{?client_prefix,●,} "
set -g @catppuccin_uptime_icon " 󰔟 "
set -g @catppuccin_date_time_icon " 󰃰 "
set -g @catppuccin_user_icon " 󰀄 "
set -g @catppuccin_host_icon " 󰒋 "

# date_time module
set -g @catppuccin_date_time_text "%R"
set -g @catppuccin_date_time_color "#{@thm_blue}"

# session module
set -g @catppuccin_session_text "#S "

# battery module: direct script calls (#{battery_*} don't expand in E: templates)
set -g @catppuccin_battery_icon " #(~/.tmux/plugins/tmux-battery/scripts/battery_icon.sh) "
set -g @catppuccin_battery_text " #(~/.tmux/plugins/tmux-battery/scripts/battery_graph.sh) #(~/.tmux/plugins/tmux-battery/scripts/battery_percentage.sh)"

# status-left: host, user, session
set -g status-left-length 200
set -g  status-left "#{E:@catppuccin_status_host}"
set -ag status-left "#{E:@catppuccin_status_user}"
set -ag status-left "#{E:@catppuccin_status_session}"

# status-right: claude alerts, kbd, uptime, battery (laptops only), date_time
set -g status-right-length 130
set -g  status-right "#(~/.claude/tmux-claude-alert-indicator.sh)"
set -ag status-right "#[fg=#{@thm_surface_0},bg=default]█#[fg=#{@thm_peach},bg=#{@thm_surface_0}] 󰌌 #[fg=#{@thm_fg},bg=#{@thm_surface_0}]#(~/.local/bin/kbd-layout) #[fg=#{@thm_surface_0},bg=default]█"
set -ag status-right "#{E:@catppuccin_status_uptime}"
{{ if .laptop -}}
set -ag status-right "#{E:@catppuccin_status_battery}"
{{ end -}}
set -ag status-right "#{E:@catppuccin_status_date_time}"

# -- custom bindings -----------------------------------------------------------

# reload config
bind r source-file ~/.tmux.conf \; display "Config reloaded"

# Jump to the pane with a pending Claude alert. The @claude-alert flag is
# PANE-scoped (set by ~/.claude/hal-speak.sh), so the jump restores window and
# pane too — a session-scoped flag only got you to the session's active window.
bind c run-shell '~/.claude/tmux-claude-alert.sh'

# Clear the flag once you actually land on the alerting pane. session-window-changed
# and window-pane-changed cover navigation however it happens (keys, commands,
# mouse); clear-active only touches each attached client's current pane, so alerts
# pending in other windows survive.
set-hook -g client-session-changed "run-shell -b '~/.claude/tmux-claude-alert.sh clear-active'"
set-hook -g session-window-changed "run-shell -b '~/.claude/tmux-claude-alert.sh clear-active'"
set-hook -g window-pane-changed "run-shell -b '~/.claude/tmux-claude-alert.sh clear-active'"

# Restore default new-window on shifted key
bind C new-window

# -- Claude session descriptions -----------------------------------------------
# Fold each Claude pane's task title into a " [ … | … ]" suffix stored on the
# SESSION-scoped @claude_session_desc option (NOT the session name — a decorated
# name breaks session-wizard's directory-derived create/reuse). `prefix s` shows
# it via choose-tree's -F; names stay clean so session-wizard stays correct.
# Capture is driven by Claude Code hooks; here we only handle cleanup + manual refresh.
# Script: ~/.local/bin/tmux-claude-desc (chezmoi: dot_local/bin/executable_tmux-claude-desc).
# window-layout-changed fires when a pane is split/killed/resized (tmux has no
# pane-close hook); a closed pane drops its @claude_desc, so a recompute prunes the
# session aggregate. Over-fires on resize, but refresh only writes when it changes.
set-hook -g window-layout-changed "run-shell -b '~/.local/bin/tmux-claude-desc refresh'"
bind T run-shell -b '~/.local/bin/tmux-claude-desc refresh'

# Session picker: native choose-tree, sessions collapsed, decorated with the Claude
# task on session lines only (window/pane lines keep their own name/title).
bind s choose-tree -Zs -F '#{?session_format,#{session_name}#{@claude_session_desc},#{?window_format,#{window_index}: #{window_name}#{window_flags},#{pane_current_command}}}'

# -- plugins (tpm) -------------------------------------------------------------

set -g @plugin 'tmux-plugins/tpm'
set -g @plugin 'tmux-plugins/tmux-copycat'
set -g @plugin 'tmux-plugins/tmux-cpu'
set -g @plugin 'tmux-plugins/tmux-resurrect'
set -g @plugin '27medkamal/tmux-session-wizard'
set -g @plugin 'christoomey/vim-tmux-navigator'
set -g @plugin 'tmux-plugins/tmux-continuum'
set -g @plugin 'catppuccin/tmux'
set -g @plugin 'tmux-plugins/tmux-battery'
set -g @plugin 'tmux-plugins/tmux-open'

set -g @continuum-restore 'on'
set -g @session-wizard 'a'

# Persist & re-attach Claude Code sessions across tmux restarts.
# Sidecar files live next to each resurrect save: <save>.claude
set -g @resurrect-hook-post-save-layout '~/.local/bin/tmux-resurrect-save-claude'
set -g @resurrect-hook-post-restore-all '~/.local/bin/tmux-resurrect-restore-claude'

# Cap resurrect-save retention. Default `@resurrect-delete-backup-after` is 30d
# which lets continuum's 15-minute interval pile up thousands of files.
set -g @resurrect-delete-backup-after '3'
set -g @resurrect-keep-count '50'
set -g @resurrect-hook-post-save-all '~/.local/bin/tmux-resurrect-prune'

# Repair a truncated resurrect `last` save before continuum auto-restores, so an
# empty save (e.g. from an unclean shutdown) can't make resurrect kill session 0
# and collapse a freshly-booted server. Synchronous (no -b) -> runs before tpm.
run-shell '~/.local/bin/tmux-resurrect-sanitise-last'

# initialize tpm (keep this line at the very bottom)
run '~/.tmux/plugins/tpm/tpm'

#!/bin/sh
# Populates ~/.claude/sounds/hal/ with TTS model + notification sounds, and renders
# the .api-key from 1Password. Replaces what used to be chezmoi externals (incompatible
# with the new ~/.claude git-repo external) and the chezmoi-templated .api-key.
{{- if not .headless }}
set -eu
target="$HOME/.claude/sounds/hal"
mkdir -p "$target/voices"

download_if_missing() {
    out=$1
    url=$2
    if [ ! -s "$out" ]; then
        echo "fetching $(basename "$out")"
        curl -fsSL --create-dirs -o "$out" "$url"
    fi
}

download_if_missing "$target/chord.wav" "https://archive.org/download/Microsoft_Windows-95-System-Sounds/Windows-95-sound-effects/Windows95_%5Bwinsounds.com%5D_1897/CHORD.WAV"
download_if_missing "$target/tada.wav" "https://archive.org/download/Microsoft_Windows-95-System-Sounds/Windows-95-sound-effects/Windows95_%5Bwinsounds.com%5D_1897/TADA.WAV"
download_if_missing "$target/hal.onnx" "https://huggingface.co/campwill/HAL-9000-Piper-TTS/resolve/main/hal.onnx"
download_if_missing "$target/hal.onnx.json" "https://huggingface.co/campwill/HAL-9000-Piper-TTS/resolve/main/hal.onnx.json"
download_if_missing "$target/voices/en_GB-vctk-medium.onnx" "https://huggingface.co/rhasspy/piper-voices/resolve/v1.0.0/en/en_GB/vctk/medium/en_GB-vctk-medium.onnx?download=true"
download_if_missing "$target/voices/en_GB-vctk-medium.onnx.json" "https://huggingface.co/rhasspy/piper-voices/resolve/v1.0.0/en/en_GB/vctk/medium/en_GB-vctk-medium.onnx.json?download=true"

{{- if .work }}
umask 077
cat > "$target/.api-key" <<'EOF'
{{ onepasswordRead "op://Private/ohwhebrjqy3fb6hblm54e7uk7e/password" .opAccount }}
EOF
{{- end }}
{{- end }}

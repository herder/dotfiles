{{ if and (not .ephemeral) .tailscale -}}
#!/usr/bin/env bash
# compose: {{ include "private_dot_config/syncthing/compose.yaml.tmpl" | sha256sum }}
# data: {{ .syncthing | toJson | sha256sum }}
set -euo pipefail

# Tailnet-only: no discovery, relays or NAT punching; peers are dialled at
# their tailscale IPs and refused from anywhere else.
tailnet='["100.64.0.0/10","fd7a:115c:a1e0::/48"]'
declare -A peers=({{ range $host, $id := .syncthing.devices }}[{{ $host }}]={{ $id }} {{ end }})
{{- $members := list }}{{ range .syncthing.devices }}{{ $members = append $members (dict "deviceID" .) }}{{ end }}
declare -A folders=(
{{- range $id, $f := .syncthing.folders }}
    [{{ $id }}]={{ dict "id" $id "label" $f.label "path" (printf "%s/%s" $.chezmoi.homeDir $f.path) "devices" $members | toJson | squote }}
{{- end }}
)

state="$HOME/.local/state/syncthing"
# Create mount sources first, or dockerd creates them root-owned.
mkdir -p "$state" "$HOME/Sync"{{ range .syncthing.folders }} "$HOME/{{ .path }}"{{ end }}
docker compose -f "$HOME/.config/syncthing/compose.yaml" up -d --wait

self_ip=$(tailscale ip -4)
key=$(sed -n 's:.*<apikey>\(.*\)</apikey>.*:\1:p' "$state/config.xml")
api() { curl -fsS -H "X-API-Key: $key" -H 'Content-Type: application/json' "$@"; }
base=http://127.0.0.1:8384/rest
# PUT replaces an item wholesale (dropping GUI tweaks); PATCH needs it to exist.
upsert() {
    if api "$base/config/$1/$2" >/dev/null 2>&1; then
        api -X PATCH "$base/config/$1/$2" -d "$3"
    else
        api -X PUT "$base/config/$1/$2" -d "$3"
    fi
}

api -X PATCH "$base/config/options" -d '{
  "listenAddresses": ["tcp://'"$self_ip"':22000", "quic://'"$self_ip"':22000"],
  "globalAnnounceEnabled": false,
  "localAnnounceEnabled": false,
  "relaysEnabled": false,
  "natEnabled": false,
  "urAccepted": -1,
  "crashReportingEnabled": false
}'
api -X PATCH "$base/config/defaults/folder" -d '{"path": "'"$HOME/Sync"'"}'

self=$(api "$base/system/status" | jq -r .myID)
for host in "${!peers[@]}"; do
    id=${peers[$host]}
    [[ $id == "$self" ]] && continue
    ip=$(tailscale ip -4 "$host")
    dev='{"deviceID": "'"$id"'", "name": "'"$host"'",
          "addresses": ["tcp://'"$ip"':22000", "quic://'"$ip"':22000"],
          "allowedNetworks": '"$tailnet"'}'
    upsert devices "$id" "$dev"
done
for id in "${!folders[@]}"; do
    upsert folders "$id" "${folders[$id]}"
done

if [[ " ${peers[*]} " != *" $self "* ]]; then
    echo "syncthing: add to .chezmoidata/syncthing.yaml and apply on every peer:"
    echo "  {{ .chezmoi.hostname }}: $self"
fi
echo "syncthing: GUI at http://127.0.0.1:8384"
{{ end -}}

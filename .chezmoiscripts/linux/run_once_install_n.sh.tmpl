#!/usr/bin/env bash
set -euo pipefail
# -y: no confirmation prompt; -n: leave shell init files alone (zshrc already exports N_PREFIX).
# n itself defaults to /usr/local/n unless N_PREFIX is in *its* environment too.
export N_PREFIX="$HOME/n"
if [ ! -x "$N_PREFIX/bin/n" ]; then
  curl -L https://bit.ly/n-install | bash -s -- -y -n
fi
"$N_PREFIX/bin/n" latest

{{- if and (eq .chezmoi.os "linux") (not .headless) (not .ephemeral) -}}
#!/usr/bin/env bash
# Userspace for the Ryzen AI NPU (XDNA 2): XRT plus Lemonade's local LLM server.
#
# PPA and package list come from .chezmoidata/ppa.yaml; the FastFlowLM release
# pin comes from .chezmoidata/fastflowlm.yaml.
# ppa: {{ .ppa.lemonade.uri }}
# packages: {{ .ppa.lemonade.packages | join " " }}
set -euo pipefail

PPA_URI="{{ .ppa.lemonade.uri }}"
PPA_ORIGIN="{{ .ppa.lemonade.origin }}"
PACKAGES=({{ range .ppa.lemonade.packages }}{{ . | quote }} {{ end }})

# Gate on the hardware, not on a machine tag. sobchak's 7950X has no NPU and
# never will, and a tag would only encode today's inventory.
npu_dev=""
for d in /sys/bus/pci/drivers/amdxdna/[0-9a-f]*; do
  [ -e "$d" ] && { npu_dev="$d"; break; }
done
if [ -z "$npu_dev" ]; then
  echo "ryzen-ai: no amdxdna NPU bound on this machine — skipping." >&2
  exit 0
fi

# FastFlowLM requires XDNA 2 and firmware 1.1.0.0 or later. Refuse loudly rather
# than install a stack that cannot work: the failure without this check happens
# later, inside a runtime, and reads as a Lemonade bug.
fw="$(cat "$npu_dev/fw_version" 2>/dev/null || echo 0)"
fw_major_minor="$(printf '%s\n' "$fw" | cut -d. -f1,2)"
case "$fw_major_minor" in
  1.0|0.*) echo "ryzen-ai: NPU firmware $fw is older than 1.1.0.0 — update the BIOS before installing." >&2; exit 1 ;;
esac
echo "ryzen-ai: NPU at ${npu_dev##*/}, firmware $fw"

# The in-tree driver is the supported path on 7.0+; amdxdna-dkms is deliberately
# absent from the package list, so assert the module is really there.
# /sys/module rather than `lsmod | grep -q`: under `set -o pipefail` that
# pipeline returns 141, because grep -q exits on the first match while lsmod is
# still writing and takes SIGPIPE. It therefore fails precisely when the module
# IS loaded — a fail-closed check that only misfires on success.
if [ ! -e /sys/module/amdxdna ]; then
  echo "ryzen-ai: amdxdna module not loaded despite a bound device — refusing to continue." >&2
  exit 1
fi

if ! grep -Rqs "lemonade-team" /etc/apt/sources.list.d/; then
  sudo add-apt-repository -y "$PPA_URI"
fi

missing=()
for p in "${PACKAGES[@]}"; do
  dpkg -s "$p" >/dev/null 2>&1 || missing+=("$p")
done

if [ "${#missing[@]}" -gt 0 ]; then
  sudo apt-get update
  sudo apt-get install -y "${missing[@]}"
fi

# Pop!_OS pins o=pop-os-release at 1001 for Package: *, so anything Pop also
# builds would win over this PPA at its default 500 — silently, and only
# visible as an older version. Pop ships none of these today; assert it rather
# than assume it, the same way the alsa-ucm-conf pin is asserted.
for p in "${PACKAGES[@]}"; do
  origin="$(apt-cache policy "$p" | awk '/\*\*\*/{getline; print $2, $3}')"
  case "$origin" in
    *"$PPA_ORIGIN"*|*ppa.launchpadcontent.net*) ;;
    *) echo "ryzen-ai: $p was installed from '$origin', not $PPA_URI — check the Pop pin." >&2 ;;
  esac
done

# FastFlowLM: the piece that actually runs a model on the NPU. XRT above only
# makes the device addressable — Lemonade without this serves on CPU and the
# iGPU, and `lemonade list` shows no FLM models at all.
#
# A GitHub release rather than the PPA (which ships no FLM package), and the
# distro .deb rather than the portable tarball: the payload is /opt/fastflowlm
# with 26 per-model NPU kernel libraries and dependencies on libavcodec60,
# libboost-program-options1.83.0, libfftw3-single3 and libxrt2 — apt resolves
# those, an archive extraction cannot.
FLM_REPO="{{ .fastflowlm.repo }}"
FLM_VERSION="{{ .fastflowlm.version }}"
FLM_SHA256="{{ index .fastflowlm.sha256 "ubuntu24.04" }}"

# The asset is named for the Ubuntu series it was built against. Pop!_OS
# reports the Ubuntu VERSION_ID it derives from, which is what the upstream
# builds are keyed on.
series="$(. /etc/os-release && echo "${VERSION_ID}")"
asset="fastflowlm_${FLM_VERSION}_ubuntu${series}_amd64.deb"

installed="$(dpkg-query -W -f='${Version}' fastflowlm 2>/dev/null || true)"
if [ "$installed" != "$FLM_VERSION" ]; then
  tmp="$(mktemp -d)"
  trap 'rm -rf "$tmp"' EXIT
  url="https://github.com/${FLM_REPO}/releases/download/v${FLM_VERSION}/${asset}"
  echo "ryzen-ai: fetching ${asset}"
  if ! curl -fsSL -o "$tmp/$asset" "$url"; then
    echo "ryzen-ai: no FastFlowLM build for ubuntu${series} at v${FLM_VERSION} ($url)" >&2
    exit 1
  fi
  # Installed with sudo from outside any apt signing chain, so the digest is
  # the only integrity check there is. Refuse rather than warn.
  echo "${FLM_SHA256}  $tmp/$asset" | sha256sum -c - >/dev/null || {
    echo "ryzen-ai: ${asset} failed its sha256 check — refusing to install." >&2
    exit 1
  }
  sudo apt-get install -y "$tmp/$asset"
fi

# /dev/accel/accel0 is root:render 0660, so the NPU is unreachable without the
# group. Needs a fresh login to take effect — say so, rather than leaving the
# next xrt-smi to fail with a bare permission error.
if ! id -nG "$USER" | tr ' ' '\n' | grep -qx render; then
  sudo usermod -aG render "$USER"
  echo "ryzen-ai: added $USER to 'render'; log out and back in before the NPU is usable."
fi

# vim: ft=bash
{{- end -}}

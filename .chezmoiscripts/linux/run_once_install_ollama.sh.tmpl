{{- if not .headless -}}
#!/usr/bin/env bash
set -euo pipefail

if ! command -v ollama &>/dev/null; then
  echo "Installing Ollama..."
  curl -fsSL https://ollama.com/install.sh | sh
fi

# Pull a small model for HAL 9000 quips (~1GB)
ollama pull gemma3:1b

# Pull a coding model for OpenCode (~19GB, needs >=20GB VRAM)
if lspci | grep -qi 'VGA.*AMD\|Display.*AMD\|VGA.*NVIDIA\|3D.*NVIDIA'; then
  echo "GPU detected — pulling coding model..."
  ollama pull qwen2.5-coder:32b
fi

# vim: ft=bash
{{- end }}

{{- if not .headless -}}
#!/usr/bin/env bash
set -euo pipefail

if ! command -v ollama &>/dev/null; then
  echo "Installing Ollama..."
  curl -fsSL https://ollama.com/install.sh | sh
fi

# Pull a small model for HAL 9000 quips (~1GB) — needed immediately.
# Larger models (qwen2.5-coder:32b etc.) are pulled manually and
# kept up to date by update-all's weekly Ollama refresh.
ollama pull gemma3:1b

# vim: ft=bash
{{- end }}

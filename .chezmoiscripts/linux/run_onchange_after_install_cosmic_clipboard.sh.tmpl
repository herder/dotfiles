{{- if eq .osid "linux-pop" -}}
#!/usr/bin/env bash
# weekly-trigger: {{ div (now | unixEpoch) 604800 }}
set -euo pipefail
# chezmoi may be invoked from a shell without the user bin dirs or mise shims on PATH
export PATH="$HOME/.local/share/mise/shims:$HOME/.local/bin:$HOME/.cargo/bin:$PATH"
. "$HOME/.cargo/env"

dir=$(mktemp -d)
trap 'rm -rf "$dir"' EXIT

git clone --depth 1 https://github.com/Lcstyle/clipboard-manager.git "$dir"
cd "$dir"
just build-release
sudo env PATH="$PATH" "$(mise which just)" install

echo 'COSMIC_DATA_CONTROL_ENABLED=1' | sudo tee /etc/environment.d/cosmic.conf > /dev/null
{{- end -}}

#!/usr/bin/env bash
# packages.yaml hash: {{ include ".chezmoidata/packages.yaml" | sha256sum }}
set -eu
{{ if eq .osid "linux-arch" }}
echo "Installing required arch packages"
yes | sudo pacman -S {{ .packages.linux.pacman | quoteList | join " " }}
yes | yay -S {{ .packages.linux.yay | quoteList | join " " }}
{{ else if eq .osid "linux-pop" }}
echo "Installing required apt packages"
sudo apt-get install -y {{ .packages.linux.apt | quoteList | join " " }}
{{ else if eq .osid "darwin" }}
echo "Installing macOS packages via Homebrew"
brew install {{ .packages.macos.brew | quoteList | join " " }}
brew install --cask {{ .packages.macos.cask | quoteList | join " " }}
{{ end }}
# cargo tools live in run_onchange_after_install-cargo-tools: this runs before the
# rust toolchain exists on a fresh machine.

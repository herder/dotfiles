#!/bin/sh
set -u

# ── Helpers ──────────────────────────────────────────────────────────
has() { command -v "$1" >/dev/null 2>&1; }

section() {
    printf '\n\033[1;34m── %s ──\033[0m\n' "$1"
}

skip() {
    printf '   %s not found, skipping\n' "$1"
}

run() {
    "$@" || printf '\033[1;33m   ⚠ %s returned non-zero\033[0m\n' "$1"
}

# Everything lives in main() so the shell parses the whole file before running
# any of it: chezmoi rewrites this very script, and dash reads by byte offset.
main() {
    # Dotfiles first — chezmoi's scripts install the apt repos and the tools every
    # later section consumes, so applying them last leaves each step a run behind.
    section "Dotfiles"

    if has chezmoi; then
        if [ -n "${SSH_CONNECTION:-}" ]; then
            printf '   chezmoi skipped (SSH session)\n'
        else
            printf '   chezmoi\n'
            # a newer update-all lands here, but only takes effect next run
            run chezmoi update --apply
        fi
    fi

    # ── System packages ──────────────────────────────────────────────
    section "System packages"

    if has apt; then
        printf '   apt\n'
        run sudo apt update
        run sudo apt upgrade -y
        run sudo apt autoremove -y
    elif has yay; then
        printf '   yay\n'
        run yay -Syu
        run yay -Yc --noconfirm
    fi

    if has brew; then
        printf '   brew\n'
        run brew update
        run brew upgrade
        run brew upgrade --cask
        run brew autoremove
        run brew cleanup
    fi

    if has flatpak; then
        printf '   flatpak\n'
        run flatpak update -y
        run flatpak uninstall --unused -y
        # repair prunes dangling objects from the local OSTree repo — flatpak has no `clean`
        run sudo flatpak repair
    fi

    # ── Language toolchains ──────────────────────────────────────────
    section "Language toolchains"

    if has mise; then
        printf '   mise\n'
        run mise self-update --yes
        run mise upgrade
    else
        skip "mise"
    fi

    # rust = "stable" is a channel, not a version mise can upgrade
    if has rustup; then
        printf '   rustup\n'
        run rustup update
    fi

    # ── Plugin managers & tools ──────────────────────────────────────
    section "Plugins & tools"

    if has antidote; then
        printf '   antidote\n'
        run antidote update
    fi

    if has uv; then
        printf '   uv tools\n'
        run uv tool upgrade --all
    fi

    if [ -x "$HOME/.tmux/plugins/tpm/bin/update_plugins" ]; then
        printf '   tpm (tmux plugins)\n'
        run "$HOME/.tmux/plugins/tpm/bin/update_plugins" all
    fi

    if has gh; then
        printf '   gh extensions\n'
        run gh extension upgrade --all
    fi

    if has fwupdmgr; then
        printf '   firmware\n'
        run fwupdmgr refresh --force
        run fwupdmgr update
    fi

    # ── Ollama models ────────────────────────────────────────────────
    if has ollama; then
        stamp="$HOME/.local/state/ollama-model-update"
        week_ago=$(( $(date +%s) - 604800 ))
        last_update=$(cat "$stamp" 2>/dev/null || echo 0)
        if [ "$last_update" -lt "$week_ago" ]; then
            section "Ollama models"
            for model in $(ollama list 2>/dev/null | tail -n +2 | awk '{print $1}'); do
                printf '   %s\n' "$model"
                run ollama pull "$model"
            done
            mkdir -p "$(dirname "$stamp")"
            date +%s > "$stamp"
        else
            section "Ollama models"
            printf '   updated < 7 days ago, skipping\n'
        fi
    else
        skip "ollama"
    fi

    # ── Done ─────────────────────────────────────────────────────────
    printf '\n\033[1;32mDone.\033[0m\n'
}

main "$@"

#!/usr/bin/env bash
# Switch tmux to the Claude Code session that owns a pull request or an issue,
# reviving it in a new window if only a dead session owns it.
#
# Usage: claude-goto-pr [--display] <org/repo#N> | <repo#N> | <org/repo> <N> | <github URL>
#
# --display reports through tmux display-message, for the prefix+G binding: run-shell
# output would otherwise open view mode over the pane you ran it from. Prefer the key
# to /goto-pr — a slash command is a model turn and interrupts that session's work.
#
# Ownership is claude-whose-pr's call; this only moves the client there.
set -euo pipefail

# run-shell inherits the tmux server's PATH, which may predate ~/.local/bin.
PATH="$HOME/.local/bin:$PATH"

if [[ ${1:-} == --display ]]; then
    shift
    status=0
    out=$("$0" "$@" 2>&1) || status=$?
    tmux display-message -d 8000 "goto-pr: ${out//$'\n'/ — }"
    exit "$status"
fi

IFS=$'\t' read -r kind a b < <(claude-whose-pr --target "$@")

case $kind in
    pane)
        pane=$a ;;
    resume)
        # Through the shell, so the window survives the session exiting.
        pane=$(tmux new-window -P -F '#{pane_id}' -c "$b")
        tmux send-keys -t "$pane" "claude --resume $a" Enter
        printf 'revived session %s in %s\n' "$a" "$b" ;;
    *)
        exit 1 ;;  # claude-whose-pr already said why
esac

tmux switch-client -t "$pane"
tmux select-window -t "$pane"
tmux select-pane -t "$pane"
printf 'switched to %s\n' "$pane"

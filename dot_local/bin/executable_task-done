#!/bin/bash
# Mark an Obsidian task as completed
# Usage: task-done [work|personal|all] [search text] [--include-tickler]
#
# With no search text: opens fzf to pick a task interactively.
# With search text: filters tasks by case-insensitive match.
#   - Exactly one match: completes it directly (no fzf needed).
#   - Multiple matches + TTY: opens fzf pre-filtered with the query.
#   - Multiple matches + no TTY: lists matches and exits.
# Marks selected task [x] with a ✅ completion date, matching Obsidian Tasks.

set -euo pipefail

# Safe line replacement — avoids sed delimiter issues with URLs etc.
replace_line() {
    local file="$1" line_num="$2" new_text="$3"
    local tmpfile
    tmpfile=$(mktemp)
    { head -n "$((line_num - 1))" "$file"
      printf '%s\n' "$new_text"
      tail -n "+$((line_num + 1))" "$file"
    } > "$tmpfile" && mv "$tmpfile" "$file"
}

VAULT_PATH="$HOME/Documents/Private Sync"
TODAY=$(date +%Y-%m-%d)
CONTEXT=""
SEARCH=""
INCLUDE_TICKLER=false

for arg in "$@"; do
    case "$arg" in
        --include-tickler) INCLUDE_TICKLER=true ;;
        work|w|personal|private|p|all) CONTEXT="$arg" ;;
        *) SEARCH="$arg" ;;
    esac
done

# Find all incomplete tasks across the vault
find_tasks() {
    grep -rn "^- \[[ /]\] " "$VAULT_PATH" \
        --include="*.md" \
        --exclude-dir=".trash" \
        --exclude-dir=".obsidian" \
        --exclude-dir="Templates" \
        --exclude-dir="Task Workflow Integration" \
        2>/dev/null || true
}

# Apply optional context filter
filter_by_context() {
    local tasks="$1"
    case "$CONTEXT" in
        work|w)
            echo "$tasks" | grep "#context/work" || true
            ;;
        personal|private|p)
            echo "$tasks" | grep -E "#context/(personal|private)" || true
            ;;
        *)
            echo "$tasks"
            ;;
    esac
}

# Apply optional text search (case-insensitive)
filter_by_search() {
    local tasks="$1"
    if [ -n "$SEARCH" ]; then
        echo "$tasks" | grep -i "$SEARCH" || true
    else
        echo "$tasks"
    fi
}

# Format grep lines for fzf display: strip vault path, show task text
exclude_tickled() {
    if [ "$INCLUDE_TICKLER" = true ]; then
        cat
        return
    fi
    while IFS= read -r line; do
        if [[ "$line" =~ ⏳\ ([0-9]{4}-[0-9]{2}-[0-9]{2}) ]]; then
            [[ "${BASH_REMATCH[1]}" > "$TODAY" ]] && continue
        fi
        echo "$line"
    done
}

format_for_fzf() {
    sed "s|^$VAULT_PATH/||"
}

ALL_TASKS=$(find_tasks)

if [ -z "$ALL_TASKS" ]; then
    echo "📭 No open tasks found"
    exit 0
fi

FILTERED=$(filter_by_context "$ALL_TASKS" | exclude_tickled)
FILTERED=$(filter_by_search "$FILTERED")

if [ -z "$FILTERED" ]; then
    echo "📭 No matching tasks found"
    exit 0
fi

MATCH_COUNT=$(echo "$FILTERED" | wc -l)

# If search narrowed to exactly one result, use it directly
if [ -n "$SEARCH" ] && [ "$MATCH_COUNT" -eq 1 ]; then
    SELECTED=$(echo "$FILTERED" | format_for_fzf)
# Multiple matches or no search: use fzf if interactive, otherwise list and exit
elif [ -t 0 ] && [ -t 1 ]; then
    SELECTED=$(echo "$FILTERED" | format_for_fzf | fzf \
        --prompt="Mark done > " \
        --header="Select task to complete" \
        --preview-window=hidden \
        --no-multi \
        --query="${SEARCH}" \
        --height=40%) || exit 0
else
    echo "Multiple matches — pick one or refine your search:"
    echo "$FILTERED" | format_for_fzf | sed 's/^/  /'
    exit 1
fi

# Parse the selection back into file:line
FILE="$VAULT_PATH/$(echo "$SELECTED" | cut -d: -f1)"
LINE_NUM=$(echo "$SELECTED" | cut -d: -f2)

if [ ! -f "$FILE" ]; then
    echo "Error: file not found: $FILE"
    exit 1
fi

# Calculate next recurrence date from a base date and recurrence pattern
# Usage: next_recurrence_date "2025-03-01" "every 2 weeks"
next_recurrence_date() {
    local base_date="$1"
    local pattern="$2"

    # Strip leading "every " if present
    pattern="${pattern#every }"

    # Parse "N unit" or just "unit" (implying N=1)
    local n=1 unit
    if [[ "$pattern" =~ ^([0-9]+)[[:space:]]+(.+)$ ]]; then
        n="${BASH_REMATCH[1]}"
        unit="${BASH_REMATCH[2]}"
    else
        unit="$pattern"
    fi

    # Normalize unit to GNU date relative format
    case "$unit" in
        day|days)     unit="days" ;;
        week|weeks)   unit="weeks" ;;
        month|months) unit="months" ;;
        year|years)   unit="years" ;;
        *)
            echo "Unknown recurrence unit: $unit" >&2
            return 1
            ;;
    esac

    date -d "$base_date + $n $unit" +%Y-%m-%d
}

# Read the original line
ORIGINAL=$(sed -n "${LINE_NUM}p" "$FILE")

# Replace checkbox: [ ] or [/] -> [x], and append completion date
UPDATED=$(echo "$ORIGINAL" | sed 's/- \[[ /]\] /- [x] /')

# Append ✅ date if not already present
if [[ "$UPDATED" != *"✅"* ]]; then
    UPDATED="$UPDATED ✅ $TODAY"
fi

# Apply the change
replace_line "$FILE" "$LINE_NUM" "$UPDATED"

# Show what we did
TASK_TEXT=$(echo "$UPDATED" | sed 's/^- \[x\] //')
SHORT_FILE=$(echo "$FILE" | sed "s|^$VAULT_PATH/||")
echo "✓ Completed: $TASK_TEXT"
echo "  in $SHORT_FILE"

# Handle recurrence: if the task has 🔁, create the next occurrence
if [[ "$ORIGINAL" =~ 🔁\ (.+) ]]; then
    RECURRENCE="${BASH_REMATCH[1]}"
    # Strip trailing dates (⏳📅✅), tags (#), and other emoji metadata
    RECURRENCE=$(echo "$RECURRENCE" | sed 's/ *[⏳📅✅].*//' | sed 's/ *#.*//')

    # "when done" means calculate from completion date, not original date
    WHEN_DONE=false
    if [[ "$RECURRENCE" == *"when done"* ]]; then
        WHEN_DONE=true
        RECURRENCE=$(echo "$RECURRENCE" | sed 's/ *when done//')
    fi

    if [ "$WHEN_DONE" = true ]; then
        BASE_DATE="$TODAY"
    # Obsidian Tasks priority: 📅 due > ⏳ scheduled > today
    elif [[ "$ORIGINAL" =~ 📅\ ([0-9]{4}-[0-9]{2}-[0-9]{2}) ]]; then
        BASE_DATE="${BASH_REMATCH[1]}"
    elif [[ "$ORIGINAL" =~ ⏳\ ([0-9]{4}-[0-9]{2}-[0-9]{2}) ]]; then
        BASE_DATE="${BASH_REMATCH[1]}"
    else
        BASE_DATE="$TODAY"
    fi

    NEXT_DATE=$(next_recurrence_date "$BASE_DATE" "$RECURRENCE") || exit 1

    # Build the new task: reset checkbox, update the reference date, keep everything else
    NEXT_TASK=$(echo "$ORIGINAL" | sed 's/- \[[ /]\] /- [ ] /')
    if [[ "$ORIGINAL" =~ 📅\ [0-9]{4}-[0-9]{2}-[0-9]{2} ]]; then
        NEXT_TASK=$(echo "$NEXT_TASK" | sed "s/📅 [0-9]\{4\}-[0-9]\{2\}-[0-9]\{2\}/📅 $NEXT_DATE/")
    fi
    if [[ "$ORIGINAL" =~ ⏳\ [0-9]{4}-[0-9]{2}-[0-9]{2} ]]; then
        NEXT_TASK=$(echo "$NEXT_TASK" | sed "s/⏳ [0-9]\{4\}-[0-9]\{2\}-[0-9]\{2\}/⏳ $NEXT_DATE/")
    fi

    # Append the new task after the completed one
    local tmpfile
    tmpfile=$(mktemp)
    { head -n "$LINE_NUM" "$FILE"
      printf '%s\n' "$NEXT_TASK"
      tail -n "+$((LINE_NUM + 1))" "$FILE"
    } > "$tmpfile" && mv "$tmpfile" "$FILE"

    echo "🔁 Next occurrence: $NEXT_DATE"
fi

#!/usr/bin/env bash
# tmux-resurrect post-save-all hook.
# Caps retention to the N most recent saves (default 50) and sweeps orphaned
# .claude sidecars. Complements resurrect's built-in age-based prune.
#
# Override the cap via the @resurrect-keep-count tmux option, or
# TMUX_RESURRECT_KEEP env var (env wins).

set -uo pipefail

resurrect_dir="${TMUX_RESURRECT_DIR:-$HOME/.local/share/tmux/resurrect}"
[[ -d "$resurrect_dir" ]] || exit 0

keep="${TMUX_RESURRECT_KEEP:-}"
if [[ -z "$keep" ]] && command -v tmux >/dev/null 2>&1; then
  keep="$(tmux show-option -gv @resurrect-keep-count 2>/dev/null || true)"
fi
keep="${keep:-50}"
[[ "$keep" =~ ^[0-9]+$ ]] || keep=50

# Delete everything past the keep window, plus its .claude sidecar.
mapfile -t to_delete < <(
  ls -t "$resurrect_dir"/tmux_resurrect_*.txt 2>/dev/null | tail -n +"$((keep + 1))"
)
for f in "${to_delete[@]}"; do
  rm -f "$f" "${f}.claude"
done

# Belt-and-braces: any .claude sidecar whose .txt is gone.
shopt -s nullglob
for s in "$resurrect_dir"/*.claude; do
  [[ -f "${s%.claude}" ]] || rm -f "$s"
done

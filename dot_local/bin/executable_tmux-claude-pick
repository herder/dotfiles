#!/usr/bin/env bash
# tmux-claude-pick — fzf over every Claude pane: state, task, repo@branch, location.
# Sessions start in the main checkout and claim worktrees as they go, so the pane's
# cwd says little: the worktree claude-session.lock files (pid/uuid -> pane via
# ~/.claude/sessions) give the branches and the task line written at claim time.
# Without a lock, fall back to Claude's pane title and the cwd. Bound to prefix+f.
#
#   tmux-claude-pick [client]   # pick and switch that client (popup passes #{client_name})
#   tmux-claude-pick --list     # just print the rows
set -euo pipefail

# run-shell/popups inherit the tmux server's PATH, which may predate mise.
PATH="$HOME/.local/bin:$HOME/.local/share/mise/shims:$PATH"

# pane id -> the latest-claimed worktree (repo@branch), its task line, and how many it holds
declare -A wt=() wtask=() wclaimed=() wcount=()
locks() {
    local -A pane_of_pid=() pane_of_uuid=()
    local pid uuid tm lock k v lpid luuid lbranch ltask lclaimed pane repo
    while IFS=$'\t' read -r pid uuid tm; do
        [[ -d /proc/$pid ]] || continue  # registry files outlive their process
        pane_of_pid[$pid]=${tm##*.} pane_of_uuid[$uuid]=${tm##*.}
    done < <(jq -r 'select(.tmux) | "\(.pid)\t\(.sessionId)\t\(.tmux)"' \
        "$HOME"/.claude/sessions/*.json 2>/dev/null)
    for lock in "$HOME"/src/git/github.com/*/*/.git/worktrees/*/claude-session.lock; do
        [[ -r $lock ]] || continue
        lpid="" luuid="" lbranch="" ltask="" lclaimed=""
        while IFS=: read -r k v; do
            v=${v# }
            case $k in
                pid) lpid=$v ;; uuid) luuid=$v ;; branch) lbranch=$v ;;
                task) ltask=$v ;; claimed) lclaimed=$v ;;
            esac
        done <"$lock"
        # a resumed session keeps its uuid under a new pid
        pane=""
        [[ -n $lpid ]] && pane=${pane_of_pid[$lpid]:-}
        [[ -z $pane && -n $luuid ]] && pane=${pane_of_uuid[$luuid]:-}
        [[ -n $pane ]] || continue
        repo=${lock%/.git/worktrees/*}; repo=${repo##*/}
        wcount[$pane]=$(( ${wcount[$pane]:-0} + 1 ))
        if [[ -z ${wt[$pane]:-} || $lclaimed > ${wclaimed[$pane]:-} ]]; then
            wt[$pane]=$repo@$lbranch wclaimed[$pane]=$lclaimed
            [[ -n $ltask ]] && wtask[$pane]=$ltask
        fi
    done
}

list() {
    local id state title desc path cmd loc glyph rank task where top branch
    locks
    # every field is prefixed with "=": read collapses runs of tab (whitespace IFS), so
    # an empty field would shift the rest, and tmux escapes control-char separators
    while IFS=$'\t' read -r id state title desc path cmd loc; do
        id=${id#=} state=${state#=} title=${title#=} desc=${desc#=} path=${path#=} cmd=${cmd#=} loc=${loc#=}
        [[ $cmd == claude ]] || continue
        case $state in
            blocked) glyph='󰂚' rank=0 ;;
            done)    glyph='✔' rank=1 ;;
            working) glyph='▶' rank=2 ;;
            *)       glyph='·' rank=3 ;;  # column -t would eat a space
        esac
        task=${wtask[$id]:-${desc:-${title#✳ }}}
        where=${path/#$HOME/\~}
        if [[ -n ${wt[$id]:-} ]]; then
            where=${wt[$id]}
            (( wcount[$id] > 1 )) && where+=" +$(( wcount[$id] - 1 ))"
        elif top=$(git -C "$path" rev-parse --show-toplevel 2>/dev/null); then
            branch=$(git -C "$path" branch --show-current 2>/dev/null) || branch=""
            where="${top##*/}@${branch:-detached}"
        fi
        printf '%s\t%s\t%s %s\t%s\t%s\n' "$rank" "$id" "$glyph" "$task" "$where" "$loc"
    done < <(tmux list-panes -a -F \
        $'=#{pane_id}\t=#{@claude-state}\t=#{pane_title}\t=#{@claude_desc}\t=#{pane_current_path}\t=#{pane_current_command}\t=#{session_name}:#{window_index}.#{pane_index}') \
        | sort -t$'\t' -k1,1n -k5,5 | cut -f2- | column -t -s$'\t' -o '  ' \
        | sed -E 's/^(%[0-9]+) +/\1\t/'
}

if [[ ${1:-} == --list ]]; then list; exit; fi
client=${1:-}

# shellcheck disable=SC2016  # $FZF_PREVIEW_LINES is fzf's to expand
pane=$(list | fzf --delimiter=$'\t' --with-nth=2 --no-sort --reverse \
        --preview 'tmux capture-pane -ep -t {1} | tail -n "$FZF_PREVIEW_LINES"' \
        --preview-window 'down,50%,border-top' | cut -f1) || exit 0
[[ -n $pane ]] || exit 0

tmux switch-client ${client:+-c "$client"} -t "$pane"
tmux select-window -t "$pane"
tmux select-pane -t "$pane"

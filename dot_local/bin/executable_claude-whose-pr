#!/usr/bin/env bash
# Which Claude Code session owns a pull request or an issue?
#
# Usage: claude-whose-pr [--pane] <org/repo#N>
#        claude-whose-pr [--pane] <org/repo> <N>
#        claude-whose-pr [--pane] https://github.com/<org>/<repo>/(pull|issues)/<N>
# --pane prints only the tmux pane of the live owning session (for claude-goto-pr)
# and fails if there is none.
# Examples:
#   claude-whose-pr Stravito/platform#9779
#   claude-whose-pr Stravito/auth 226
#
# Derives the answer instead of storing it:
#   PR -> head branch (gh) -> the worktree holding that branch (git)
#      -> that worktree's claude-session.lock -> the owning session.
#   An issue has no branch of its own, so it fans out first: its linked
#   branches (`gh issue develop`) and the head branches of the PRs that close
#   it, each walked as above.
#
# Nothing is indexed, so nothing goes stale when a worktree changes hands. A
# session may own many worktrees across many repos; that does not matter here
# because the traversal is many-to-one and runs toward the one.
#
# The repo must be named: a bare number is ambiguous across repos, and gh would
# resolve it against whatever directory you happen to be standing in.
set -euo pipefail

die() { printf '%s: %s\n' "${0##*/}" "$*" >&2; exit 1; }

pane_mode=0
if [[ ${1:-} == --pane ]]; then
    pane_mode=1; shift
    # Keep the report logic single-sourced: run it as usual, discard the prose.
    exec 3>&1 1>/dev/null
fi

# A pasted URL is the other natural thing to type.
if [[ $# -eq 1 && $1 =~ ^https?://github\.com/([^/]+/[^/]+)/(pull|issues)/([0-9]+) ]]; then
    set -- "${BASH_REMATCH[1]}" "${BASH_REMATCH[3]}"
fi

case $# in
    1) [[ $1 == *#* ]] || die "expected <org/repo#N> or <repo#N>, got '$1'"
       repo=${1%%#*}; num=${1##*#} ;;
    2) repo=$1; num=$2 ;;
    *) cat >&2 <<USAGE
Usage: ${0##*/} [--pane] <org/repo#N>   |   <repo#N>   |   <org/repo> <N>
Examples:
  ${0##*/} Stravito/platform#9779
  ${0##*/} platform#9779          # org inferred from the cwd's origin remote
  ${0##*/} Stravito/auth 226
  ${0##*/} https://github.com/Stravito/infrastructure/issues/4238
USAGE
       exit 2 ;;
esac

[[ $num =~ ^[0-9]+$ ]] || die "number must be numeric, got '$num'"

# `platform#9779` is the natural thing to type. Infer the org from the current
# repo's origin, but ONLY when the name matches -- inferring across repos would
# silently answer about the wrong one, which is the whole reason the qualified
# form is required in the first place.
if [[ $repo != */* ]]; then
    origin=$(git remote get-url origin 2>/dev/null || true)
    [[ -n $origin ]] || die "'$repo' has no org, and the current directory is not a git repo to infer one from"
    inferred=${origin%.git}; inferred=${inferred##*[:/]}
    inferred_org=$(sed -E 's|.*[:/]([^/]+)/[^/]+$|\1|' <<<"${origin%.git}")
    [[ $inferred == "$repo" ]] \
        || die "'$repo' has no org, and this directory's origin is '$inferred_org/$inferred' -- name the org explicitly"
    repo="$inferred_org/$repo"
    printf 'inferred org from origin: %s\n' "$repo" >&2
fi

org=${repo%%/*}
name=${repo##*/}

# One query answers "PR or issue?" and fetches what each needs: a PR's head
# branch, or an issue's linked branches and closing PRs.
# shellcheck disable=SC2016 # $owner etc. are GraphQL variables, not shell
ref=$(gh api graphql -f owner="$org" -f name="$name" -F num="$num" -f query='
  query($owner: String!, $name: String!, $num: Int!) {
    repository(owner: $owner, name: $name) {
      issueOrPullRequest(number: $num) {
        __typename
        ... on PullRequest { title state url headRefName }
        ... on Issue {
          title state url
          linkedBranches(first: 20) { nodes { ref { name } } }
          closedByPullRequestsReferences(first: 20, includeClosedPrs: true) {
            nodes { number headRefName }
          }
        }
      }
    }
  }' --jq '.data.repository.issueOrPullRequest' 2>/dev/null) || ref=
if [[ -z $ref || $ref == null ]]; then
    die "cannot read $repo#$num (does it exist? is gh authenticated?)"
fi

kind=$(jq -r '.__typename' <<<"$ref")
state=$(jq -r '.state' <<<"$ref")
title=$(jq -r '.title' <<<"$ref")
url=$(jq -r '.url' <<<"$ref")

printf '%s#%s  [%s %s]  %s\n%s\n\n' "$repo" "$num" "$kind" "$state" "$title" "$url"

# "<branch>\t<where it came from>", one per line, deduplicated by branch.
if [[ $kind == PullRequest ]]; then
    branches=$(jq -r '"\(.headRefName)\thead branch"' <<<"$ref")
else
    branches=$(jq -r '
        ([.linkedBranches.nodes[] | "\(.ref.name)\tlinked branch"]
         + [.closedByPullRequestsReferences.nodes[] | "\(.headRefName)\thead of PR #\(.number)"])
        | unique_by(split("\t")[0]) | .[]' <<<"$ref")
    [[ -n $branches ]] || printf 'no linked branch and no PR closes it\n'
fi

clone="$HOME/src/git/github.com/$org/$name"
[[ -d $clone/.git ]] || die "no local clone at $clone"
worktrees=$(git -C "$clone" worktree list --porcelain 2>/dev/null)

# Prints the worktree and lock for one branch; records a live owner in live_pids.
live_pids=()
report_branch() {
    local branch=$1 worktree lock lock_pid
    # `git worktree list --porcelain` emits stanzas of `worktree <path>` /
    # `branch refs/heads/<name>`, so pair them up rather than assuming order.
    worktree=$(awk -v want="refs/heads/$branch" '
        /^worktree /  { path = $2 }
        /^branch /    { if ($2 == want) { print path; exit } }
    ' <<<"$worktrees")
    [[ -n $worktree ]] || { printf 'worktree:    none\n'; return 1; }
    printf 'worktree:    %s\n' "$worktree"
    lock="$(git -C "$worktree" rev-parse --git-dir)/claude-session.lock"
    if [[ -r $lock ]]; then
        printf '\n--- owning session ---\n'
        cat "$lock"
        # A lock outlives the session that wrote it -- a resumed session comes
        # back under a new name, and a crashed one never cleans up. The recorded
        # pid is the cheapest local liveness signal; check the cmdline too, since
        # pids get recycled and a stranger's process would otherwise read as live.
        lock_pid=$(awk -F': *' '/^pid:/ {print $2; exit}' "$lock")
        if [[ -n ${lock_pid:-} && -r /proc/$lock_pid/cmdline ]] \
           && tr '\0' ' ' < "/proc/$lock_pid/cmdline" | grep -qi claude; then
            printf '\nProcess %s is alive — the lock looks current.\n' "$lock_pid"
            live_pids+=("$lock_pid")
        else
            printf '\n*** STALE: process %s is gone, so that session has ended. ***\n' "${lock_pid:-?}"
            printf 'The work may well be continuing under a new session name (a resumed\n'
            printf 'session is renamed), so treat this as "nobody is holding it right now"\n'
            printf 'rather than "nobody did it".\n'
        fi
    else
        printf '\nNo session lock: the worktree exists but no session has claimed it.\n'
        printf 'Either the work predates the lock convention, or nobody is on it.\n'
    fi
}

any_worktree=0
while IFS=$'\t' read -r branch source; do
    [[ -n $branch ]] || continue
    printf '\n%s: %s\n' "$source" "$branch"
    report_branch "$branch" && any_worktree=1
done <<<"$branches"

if (( ! any_worktree )); then
    printf '\nNo worktree holds any of its branches: removed after merge, or the work\n'
    printf 'was never branched. Searching session transcripts for a session that\n'
    printf 'mentioned it...\n\n'
    # Match the URL and the fully-qualified shorthand; a bare "#N" would collide
    # with unrelated issue numbers in other repos.
    found=0
    while IFS= read -r t; do
        found=1
        id=$(basename "$t" .jsonl)
        # Subagent transcripts are named agent-*; only bare UUIDs are sessions a
        # human was driving, which is what "whose" is actually asking about.
        case $id in
            agent-*) who='subagent' ;;
            *)       who='session ' ;;
        esac
        printf '  %s %s  (last written %s)\n' "$who" "$id" \
            "$(date -r "$t" '+%Y-%m-%d %H:%M' 2>/dev/null || echo '?')"
    done < <(grep -rl -e "$url" -e "$repo#$num" \
                 --include='*.jsonl' "$HOME/.claude/projects" 2>/dev/null | head -10)
    (( found )) || printf '  nothing found — no transcript on this machine mentions it\n'
    printf '\n(Transcript ids are Claude session UUIDs, not tmux panes; locks are\n'
    printf 'per-machine, so another machine may hold the answer.)\n'
fi

# Live cross-check. Claude Code sets each pane's title to its current task, and
# the tmux-claude-desc hook rewrites GitHub references into <repo>#<N>, so an
# active pane working this PR or issue shows up here even with no lock.
if [[ -n ${TMUX:-} ]] || tmux list-panes -a >/dev/null 2>&1; then
    panes=$(tmux list-panes -a -F '#{session_name}:#{window_index}.#{pane_id}	#{pane_title}' 2>/dev/null \
            | grep -F "$name#$num" || true)
    if [[ -n $panes ]]; then
        printf '\n--- live panes whose title names it ---\n%s\n' "$panes"
    fi
fi

(( pane_mode )) || exit 0

# The lock's own `pane:` field goes stale when a session is resumed elsewhere, so
# find the pane from the live pid: climb its ancestors to a pane's shell.
pane_of_pid() {
    local p=$1 map id
    map=$(tmux list-panes -a -F '#{pane_pid} #{pane_id}')
    while [[ -n $p && $p -gt 1 ]]; do
        id=$(awk -v p="$p" '$1 == p { print $2; exit }' <<<"$map")
        [[ -n $id ]] && { printf '%s\n' "$id"; return 0; }
        p=$(ps -o ppid= -p "$p" | tr -d ' ')
    done
    return 1
}

# An issue can have several branches; only one distinct live owner is an answer.
mapfile -t live_pids < <(printf '%s\n' "${live_pids[@]}" | sort -u | grep . || true)
if (( ${#live_pids[@]} > 1 )); then
    die "several live sessions hold branches of $repo#$num (pids ${live_pids[*]}); run claude-whose-pr without --pane"
elif (( ${#live_pids[@]} == 1 )); then
    pane_of_pid "${live_pids[0]}" >&3 || die "owning session (pid ${live_pids[0]}) is not in a tmux pane"
elif [[ -n ${panes:-} && $(wc -l <<<"$panes") -eq 1 ]]; then
    # No live lock, but exactly one pane says it is on this PR.
    awk -F'\t' '{ sub(/.*\./, "", $1); print $1 }' <<<"$panes" >&3
else
    die "no live session owns $repo#$num (run claude-whose-pr without --pane for details)"
fi

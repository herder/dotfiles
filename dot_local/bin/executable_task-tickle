#!/bin/bash
# Move a task to the tickler list (defer until a future date)
# Usage: task-tickle [--filter work|personal|all]
#
# Opens fzf with open tasks. Select one, enter a date, and it gets
# a ⏳ scheduled date. Tasks with a future ⏳ date are hidden from
# normal task-list views and resurface when the date arrives.

set -euo pipefail

VAULT_PATH="$HOME/Documents/Private Sync"
TODAY=$(date +%Y-%m-%d)

FILTER="${1:-}"

find_tasks() {
    grep -rn "^- \[[ /]\] " "$VAULT_PATH" \
        --include="*.md" \
        --exclude-dir=".trash" \
        --exclude-dir=".obsidian" \
        --exclude-dir="Templates" \
        --exclude-dir="Task Workflow Integration" \
        2>/dev/null || true
}

filter_tasks() {
    local tasks="$1"
    case "$FILTER" in
        work|w)
            echo "$tasks" | grep "#context/work" || true
            ;;
        personal|private|p)
            echo "$tasks" | grep -E "#context/(personal|private)" || true
            ;;
        *)
            echo "$tasks"
            ;;
    esac
}

format_for_fzf() {
    sed "s|^$VAULT_PATH/||"
}

# Exclude tasks that are already tickled (have a future ⏳ date)
exclude_already_tickled() {
    while IFS= read -r line; do
        if [[ "$line" =~ ⏳\ ([0-9]{4}-[0-9]{2}-[0-9]{2}) ]]; then
            local sched="${BASH_REMATCH[1]}"
            [[ "$sched" > "$TODAY" ]] && continue
        fi
        echo "$line"
    done
}

ALL_TASKS=$(find_tasks)

if [ -z "$ALL_TASKS" ]; then
    echo "📭 No open tasks found"
    exit 0
fi

FILTERED=$(filter_tasks "$ALL_TASKS" | exclude_already_tickled)

if [ -z "$FILTERED" ]; then
    echo "📭 No matching tasks found"
    exit 0
fi

SELECTED=$(echo "$FILTERED" | format_for_fzf | fzf \
    --prompt="Tickle > " \
    --header="Select task to defer" \
    --preview-window=hidden \
    --no-multi \
    --height=40%) || exit 0

FILE="$VAULT_PATH/$(echo "$SELECTED" | cut -d: -f1)"
LINE_NUM=$(echo "$SELECTED" | cut -d: -f2)

if [ ! -f "$FILE" ]; then
    echo "Error: file not found: $FILE"
    exit 1
fi

# Prompt for the tickle date
printf "Tickle until (YYYY-MM-DD, +Nd, +Nw, +Nm, +Ny): "
read -r DATE_INPUT

# Parse relative dates
if [[ "$DATE_INPUT" =~ ^\+([0-9]+)d$ ]]; then
    TICKLE_DATE=$(date -d "+${BASH_REMATCH[1]} days" +%Y-%m-%d)
elif [[ "$DATE_INPUT" =~ ^\+([0-9]+)w$ ]]; then
    TICKLE_DATE=$(date -d "+${BASH_REMATCH[1]} weeks" +%Y-%m-%d)
elif [[ "$DATE_INPUT" =~ ^\+([0-9]+)m$ ]]; then
    TICKLE_DATE=$(date -d "+${BASH_REMATCH[1]} months" +%Y-%m-%d)
elif [[ "$DATE_INPUT" =~ ^\+([0-9]+)y$ ]]; then
    TICKLE_DATE=$(date -d "+${BASH_REMATCH[1]} years" +%Y-%m-%d)
elif [[ "$DATE_INPUT" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]]; then
    TICKLE_DATE="$DATE_INPUT"
else
    echo "Error: invalid date format (use YYYY-MM-DD, +Nd, +Nw, +Nm, +Ny)"
    exit 1
fi

if [[ "$TICKLE_DATE" < "$TODAY" || "$TICKLE_DATE" == "$TODAY" ]]; then
    echo "Error: tickle date must be in the future"
    exit 1
fi

# Read the original line
ORIGINAL=$(sed -n "${LINE_NUM}p" "$FILE")

# Remove existing ⏳ date if present, then add new one
UPDATED=$(echo "$ORIGINAL" | sed 's/ *⏳ *[0-9]\{4\}-[0-9]\{2\}-[0-9]\{2\}//')
UPDATED="$UPDATED ⏳ $TICKLE_DATE"

# Apply the change
sed -i "${LINE_NUM}s|.*|${UPDATED}|" "$FILE"

TASK_TEXT=$(echo "$UPDATED" | sed 's/^- \[[ /]\] //')
SHORT_FILE=$(echo "$FILE" | sed "s|^$VAULT_PATH/||")
echo "⏳ Tickled until $TICKLE_DATE: $TASK_TEXT"
echo "  in $SHORT_FILE"

#!/usr/bin/env bash
# tmux-resurrect post-save-layout hook.
# Writes a sidecar <save_path>.claude mapping tmux pane -> Claude sessionId,
# so the restore hook can re-attach each pane to its prior session.
#
# Designed to be silently inert if claude/jq are missing or if `claude agents
# --json` is unavailable (older Claude Code versions) — never causes the
# enclosing resurrect save to fail.

set -uo pipefail

save_path="${1:-}"
[[ -z "$save_path" ]] && exit 0

sidecar="${save_path}.claude"
save_dir="$(dirname "$save_path")"

# Orphan-sidecar prune runs unconditionally — keeps the directory tidy even
# if claude has since been uninstalled.
prune_orphans() {
  shopt -s nullglob
  local s
  for s in "$save_dir"/*.claude; do
    [[ -f "${s%.claude}" ]] || rm -f "$s"
  done
}
trap prune_orphans EXIT

# Hard prerequisites. Missing → bail without error.
command -v claude >/dev/null 2>&1 || exit 0
command -v jq >/dev/null 2>&1 || exit 0
command -v tmux >/dev/null 2>&1 || exit 0

# Capture and validate the agent list. Any failure mode → skip silently.
agents_json="$(claude agents --json 2>/dev/null)" || exit 0
[[ -n "$agents_json" ]] || exit 0
echo "$agents_json" | jq -e 'type == "array"' >/dev/null 2>&1 || exit 0

# pane_pid -> "session:window.pane"
declare -A pane_for_pid
while read -r pid ref; do
  [[ -z "$pid" ]] && continue
  pane_for_pid["$pid"]="$ref"
done < <(tmux list-panes -aF '#{pane_pid} #{session_name}:#{window_index}.#{pane_index}' 2>/dev/null)

# Walk a process's ancestry until we hit a known pane pid, or give up.
ancestor_pane() {
  local pid="$1" depth=0
  while [[ -n "$pid" && "$pid" != 1 && "$pid" != 0 && $depth -lt 32 ]]; do
    if [[ -n "${pane_for_pid[$pid]+x}" ]]; then
      printf '%s\n' "${pane_for_pid[$pid]}"
      return 0
    fi
    pid=$(ps -o ppid= -p "$pid" 2>/dev/null | tr -d ' ' || true)
    depth=$((depth + 1))
  done
  return 1
}

tmp="$(mktemp)" || exit 0
trap 'rm -f "$tmp"; prune_orphans' EXIT

echo "$agents_json" \
  | jq -r '.[] | select(.kind == "interactive") | [.pid, .sessionId, .cwd] | @tsv' 2>/dev/null \
  | while IFS=$'\t' read -r pid sid cwd; do
      [[ -z "$pid" || -z "$sid" ]] && continue
      if pane=$(ancestor_pane "$pid"); then
        printf '%s\t%s\t%s\n' "$pane" "$sid" "$cwd"
      fi
    done > "$tmp"

if [[ -s "$tmp" ]]; then
  mv "$tmp" "$sidecar"
else
  rm -f "$sidecar"
fi

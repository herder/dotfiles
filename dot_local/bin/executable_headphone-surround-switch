#!/usr/bin/env bash
# Watch for audio device changes and auto-switch:
# - Perfect EQ auto-inserts via WirePlumber smart filter (no manual routing needed)
# - When Bluetooth/USB headphones connect, switch to Virtual Surround Sink
# - When headphones disconnect, switch back to best hardware sink
# - Profile selection is left to WirePlumber (api.acp.auto-profile = true in
#   50-ifi-usb-audio.conf). Forcing pro-audio has caused "No space left on
#   device" / "Not enough bandwidth for altsetting 3" through the Thunderbolt
#   dock's shared USB2 bus, and "no output" issues historically.
set -euo pipefail

SURROUND_NODE="effect_input.virtual-surround-7.1-hesuvi"

get_node_id() {
    pw-cli ls Node 2>/dev/null | awk -v name="$1" '
        /^[[:space:]]*id [0-9]+,/ { split($2, a, ","); id = a[1] }
        /node.name/ && $0 ~ "\"" name "\"" { print id; exit }
    '
}

get_default_sink_name() {
    # Match only the property line (anchored with leading whitespace and `=`),
    # not occurrences of "node.name" embedded in other properties' JSON values
    # (e.g. filter.smart.target = "{ "node.name" = "..." }").
    wpctl inspect @DEFAULT_AUDIO_SINK@ 2>/dev/null \
        | awk -F'"' '/^[[:space:]*]*node\.name[[:space:]]*=/ {print $2; exit}'
}

has_headphone_sink() {
    wpctl status 2>/dev/null | sed -n '/Sinks:/,/Sources:/p' | grep -iv 'iFi' | grep -iv 'Dock' | grep -qiE 'bluez|usb'
}

# Find the highest-priority hardware sink (excludes filter/effect/virtual sinks)
find_best_hw_sink() {
    pw-dump --no-colors 2>/dev/null | python3 -c "
import json, sys
best_id, best_pri = None, -1
for n in json.load(sys.stdin):
    p = n.get('info', {}).get('props', {})
    if p.get('media.class') != 'Audio/Sink':
        continue
    name = p.get('node.name', '')
    if name.startswith('effect_input.'):
        continue
    if 'bluez' in name or 'virtual-surround' in name:
        continue
    pri = int(p.get('priority.session', 0))
    if pri > best_pri:
        best_id, best_pri = n['id'], pri
if best_id:
    print(best_id)
"
}

# If the current default is virtual surround (headphones disconnected),
# switch to the best hardware sink. WirePlumber will re-insert smart
# filters (Perfect EQ, Speaker Auto Gain) on the new default automatically.
#
# NOTE: only touch virtual surround here — it's the only filter managed
# manually by this daemon. Smart filters (effect_input.perfect-eq,
# effect_input.speaker-autogain) are managed by WirePlumber and MUST NOT
# be "corrected" away, or the smart filter chain breaks.
switch_from_surround() {
    local best_id current
    best_id=$(find_best_hw_sink)
    [ -z "$best_id" ] && return
    current=$(get_default_sink_name)
    if [ "$current" = "$SURROUND_NODE" ]; then
        wpctl set-default "$best_id"
        echo "$(date): Switched default from Virtual Surround to best hardware sink"
    fi
}

# Wait for PipeWire to fully initialize (up to ~15s) before first check.
# At cold boot, the service may start before ALSA has enumerated the sinks.
wait_for_hardware_sink() {
    local i=0
    while [ $i -lt 30 ]; do
        [ -n "$(find_best_hw_sink)" ] && return 0
        sleep 0.5
        i=$((i + 1))
    done
    return 1
}

switch_to_surround() {
    local surround_id
    surround_id=$(get_node_id "$SURROUND_NODE")
    if [ -n "$surround_id" ]; then
        local current
        current=$(get_default_sink_name)
        if [ "$current" != "$SURROUND_NODE" ]; then
            wpctl set-default "$surround_id"
            echo "$(date): Switched to Virtual Surround Sink (headphones connected)"
        fi
    else
        echo "$(date): Virtual Surround Sink not found, skipping"
    fi
}

echo "$(date): Watching for audio device changes..."

# Check initial state
wait_for_hardware_sink
switch_from_surround
if has_headphone_sink; then
    switch_to_surround
fi

# Monitor PipeWire for any change (node add/remove or metadata change).
# pw-mon emits multi-line events; the type lines are tab-indented, so the
# action keyword (added:/removed:/changed:) appears on its own line at col 0.
# An earlier pattern (*added*Node*) tried to match both on one line and never
# fired. Reacting to `changed:` picks up device connect/disconnect events.
#
# Rate-limit: pw-mon can emit hundreds of events in a burst (PipeWire startup,
# USB enumeration). Keep a minimum gap between checks so we don't thrash.
last_check=0
pw-mon --no-colors 2>/dev/null | while read -r line; do
    case "$line" in
        added:|removed:|changed:)
            now=$(date +%s)
            if [ $((now - last_check)) -lt 2 ]; then
                continue
            fi
            last_check=$now
            # Let PipeWire finish propagating the change before reading state
            sleep 1
            if has_headphone_sink; then
                switch_to_surround
            else
                switch_from_surround
            fi
            ;;
    esac
done

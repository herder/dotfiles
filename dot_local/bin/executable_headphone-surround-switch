#!/usr/bin/env bash
# Watch for audio device changes and auto-switch:
# - Perfect EQ auto-inserts via WirePlumber smart filter (no manual routing needed)
# - When Bluetooth/USB headphones connect, switch to Virtual Surround Sink
# - When headphones disconnect, switch back to best hardware sink
# - Activate iFi USB DAC profile when present (highest priority → becomes default)
set -euo pipefail

SURROUND_NODE="effect_input.virtual-surround-7.1-hesuvi"

get_node_id() {
    pw-cli ls Node 2>/dev/null | awk -v name="$1" '
        /^[[:space:]]*id [0-9]+,/ { split($2, a, ","); id = a[1] }
        /node.name/ && $0 ~ "\"" name "\"" { print id; exit }
    '
}

get_default_sink_name() {
    wpctl inspect @DEFAULT_AUDIO_SINK@ 2>/dev/null | awk -F'"' '/node.name/ {print $2}'
}

has_headphone_sink() {
    wpctl status 2>/dev/null | sed -n '/Sinks:/,/Sources:/p' | grep -iv 'iFi' | grep -iv 'Dock' | grep -qiE 'bluez|usb'
}

ensure_ifi_profile() {
    local card
    card=$(pactl list cards short 2>/dev/null | awk '/iFi/ {print $2}')
    if [ -n "$card" ]; then
        pactl set-card-profile "$card" pro-audio 2>/dev/null || true
    fi
}

# Find the highest-priority hardware sink (excludes virtual/filter sinks)
switch_to_best_sink() {
    local best_id
    best_id=$(pw-dump --no-colors 2>/dev/null | python3 -c "
import json, sys
best_id, best_pri = None, -1
for n in json.load(sys.stdin):
    p = n.get('info', {}).get('props', {})
    if p.get('media.class') == 'Audio/Sink':
        name = p.get('node.name', '')
        if 'bluez' not in name and 'virtual-surround' not in name and 'perfect-eq' not in name:
            pri = int(p.get('priority.session', 0))
            if pri > best_pri:
                best_id, best_pri = n['id'], pri
if best_id:
    print(best_id)
")
    if [ -n "$best_id" ]; then
        local current
        current=$(get_default_sink_name)
        if [ "$current" = "$SURROUND_NODE" ] || [ "$current" = "effect_input.perfect-eq" ]; then
            wpctl set-default "$best_id"
            echo "$(date): Switched to best hardware sink"
        fi
    fi
}

switch_to_surround() {
    local surround_id
    surround_id=$(get_node_id "$SURROUND_NODE")
    if [ -n "$surround_id" ]; then
        local current
        current=$(get_default_sink_name)
        if [ "$current" != "$SURROUND_NODE" ]; then
            wpctl set-default "$surround_id"
            echo "$(date): Switched to Virtual Surround Sink (headphones connected)"
        fi
    else
        echo "$(date): Virtual Surround Sink not found, skipping"
    fi
}

echo "$(date): Watching for audio device changes..."

# Check initial state
ensure_ifi_profile
sleep 0.5
switch_to_best_sink
if has_headphone_sink; then
    switch_to_surround
fi

# Monitor PipeWire for node changes (covers BT connect/disconnect)
pw-mon --no-colors 2>/dev/null | while read -r line; do
    case "$line" in
        *added*Node*|*removed*Node*)
            # Brief delay to let PipeWire settle
            sleep 1
            ensure_ifi_profile
            if has_headphone_sink; then
                switch_to_surround
            else
                switch_to_best_sink
            fi
            ;;
    esac
done

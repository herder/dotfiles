#!/bin/bash
# Sync tasks from external sources into today's daily note
# Usage: task-sync gh

set -euo pipefail

# Configuration
VAULT_PATH="$HOME/Documents/Private Sync"
DAILY_NOTE_DIR="$VAULT_PATH/Notes/Daily"
TEMPLATE_FILE="$VAULT_PATH/Templates/Daily Note.md"

GH_PROJECT_NUMBER={{ .ghProjectNumber | quote }}
GH_PROJECT_OWNER={{ .ghProjectOwner | quote }}
GH_USERNAME={{ .ghUsername | quote }}

# Colors
BOLD='\033[1m'
DIM='\033[2m'
RESET='\033[0m'

# Ensure daily note exists, creating from template if needed
ensure_daily_note() {
    local target_date="$1"
    local year month day_name daily_note

    year=$(echo "$target_date" | cut -d- -f1)
    month=$(echo "$target_date" | cut -d- -f2)
    daily_note="$DAILY_NOTE_DIR/$year/$month/$target_date.md"

    if [ ! -f "$daily_note" ]; then
        mkdir -p "$DAILY_NOTE_DIR/$year/$month"
        day_name=$(date -d "$target_date" +%A 2>/dev/null || echo "Unknown")
        sed "s/{{ "{{" }}date:YYYY-MM-DD{{ "}}" }}/$target_date/g; s/{{ "{{" }}date:YYYY{{ "}}" }}/$year/g; s/{{ "{{" }}date:MM{{ "}}" }}/$month/g; s/{{ "{{" }}date:dddd{{ "}}" }}/$day_name/g" \
            "$TEMPLATE_FILE" > "$daily_note"
        echo "✓ Created daily note: $target_date" >&2
    fi

    echo "$daily_note"
}

# GitHub sync output directory
GH_SYNC_DIR="$VAULT_PATH/Work/GitHub"

# Safe line replacement — avoids sed delimiter issues with URLs etc.
replace_line() {
    local file="$1" line_num="$2" new_text="$3"
    local tmpfile
    tmpfile=$(mktemp)
    { head -n "$((line_num - 1))" "$file"
      printf '%s\n' "$new_text"
      tail -n "+$((line_num + 1))" "$file"
    } > "$tmpfile" && mv "$tmpfile" "$file"
}

# Close vault tasks whose linked GitHub issue/PR has been closed
close_resolved_tasks() {
    local today="$1"

    echo ""
    echo -e "${BOLD}🔍 Checking for resolved GitHub tasks...${RESET}"

    # Find open tasks with GitHub URLs across the vault
    local matches
    matches=$(grep -rn "^- \[[ /]\] .*https://github.com/" "$VAULT_PATH" \
        --include="*.md" \
        --exclude-dir=".trash" \
        --exclude-dir=".obsidian" \
        --exclude-dir="Templates" \
        2>/dev/null || true)

    if [ -z "$matches" ]; then
        echo -e "  ${DIM}No open tasks with GitHub links${RESET}"
        return 0
    fi

    local closed_count=0

    while IFS= read -r match; do
        local file line_num line_text gh_url api_path state

        file=$(echo "$match" | cut -d: -f1)
        line_num=$(echo "$match" | cut -d: -f2)
        line_text=$(echo "$match" | cut -d: -f3-)

        # Extract the GitHub URL
        gh_url=$(echo "$line_text" | grep -oP 'https://github\.com/[^)]+' | head -1)
        [ -z "$gh_url" ] && continue

        # Convert to API path: /repos/owner/repo/issues/N or /repos/owner/repo/pulls/N
        api_path=$(echo "$gh_url" | sed -n 's|https://github.com/\(.*\)/\(issues\|pull\)/\([0-9]*\).*|/repos/\1/issues/\3|p')
        [ -z "$api_path" ] && continue

        # Check state via GitHub API (issues endpoint works for both issues and PRs)
        state=$(gh api "$api_path" --jq '.state' 2>/dev/null || echo "unknown")

        if [ "$state" = "closed" ]; then
            local updated
            updated=$(echo "$line_text" | sed 's/- \[[ /]\] /- [x] /')
            if [[ "$updated" != *"✅"* ]]; then
                updated="$updated ✅ $today"
            fi
            replace_line "$file" "$line_num" "$updated"

            local task_title
            task_title=$(echo "$updated" | sed 's/^- \[x\] //' | sed 's/ \[.*//')
            echo -e "  ✅ Closed: ${DIM}$task_title${RESET}"
            closed_count=$((closed_count + 1))
        fi
    done <<< "$matches"

    if [ "$closed_count" -gt 0 ]; then
        echo -e "${BOLD}✓ Auto-closed $closed_count resolved tasks${RESET}"
    else
        echo -e "  ${DIM}All linked tasks are still open${RESET}"
    fi
}

# --- GitHub sync ---

sync_github() {
    local today
    today=$(date +%Y-%m-%d)

    echo -e "${BOLD}🔄 Syncing from GitHub project ($GH_PROJECT_OWNER #$GH_PROJECT_NUMBER)...${RESET}"

    # Fetch project items
    local json
    json=$(gh project item-list "$GH_PROJECT_NUMBER" --owner "$GH_PROJECT_OWNER" --format json --limit 200 2>&1) || {
        echo "Error: Failed to fetch GitHub project items"
        echo "$json"
        exit 1
    }

    # Filter and transform with jq
    local tasks
    tasks=$(echo "$json" | jq -r --arg user "$GH_USERNAME" '
        .items
        | map(select(
            (.assignees // [] | index($user)) and
            (.status != "✅ Done")
        ))
        | map(
            # Checkbox based on status
            (if .status == "🏗 In progress" or .status == "👀 In review"
             then "- [/] "
             else "- [ ] "
             end) +

            # Title (clean up common prefixes)
            (.title | gsub("^\\[(chore/fix|feature|TASK)\\]\\s*"; "") | gsub("^(feat|fix|chore):\\s*"; "")) +

            # Issue link
            (if .content.url then
                " [" +
                (.content.repository + "#" + (.content.number | tostring)
                 | gsub({{ printf "%s/" .ghProjectOwner | quote }}; "")) +
                "](" + .content.url + ")"
             else ""
             end) +

            # Priority
            (if .priority == "🌋 Urgent" then " 🔺"
             elif .priority == "🏔 High" then " ⏫"
             elif .priority == "🏝 Low" then " 🔽"
             else ""
             end) +

            # Deadline
            (if .deadline then " 📅 " + .deadline else "" end) +

            # Sprint info
            (if .sprint.title then " (" + .sprint.title + ")" else "" end) +

            # Tags
            " #stravito #context/work"
        )
        | .[]
    ')

    # Fetch PR review requests
    echo -e "${BOLD}🔄 Fetching PR review requests...${RESET}"

    local reviews
    reviews=$(gh search prs --review-requested=@me --state=open --json title,url,repository --jq '
        .[]
        | "- [ ] Review: " + .title +
          " [" + (.repository.nameWithOwner | gsub({{ printf "%s/" .ghProjectOwner | quote }}; "")) + "](" + .url + ")" +
          " #review #context/work"
    ')

    # Build the sync file content
    local timestamp
    timestamp=$(date "+%Y-%m-%d %H:%M")
    local sync_file="$GH_SYNC_DIR/$today.md"
    mkdir -p "$GH_SYNC_DIR"

    {
        printf '> Synced from Pipedream project — %s\n\n' "$timestamp"

        if [ -n "$tasks" ]; then
            printf '## Project Tasks\n\n%s\n\n' "$tasks"
        else
            printf '## Project Tasks\n\n*No active items assigned to %s*\n\n' "$GH_USERNAME"
        fi

        if [ -n "$reviews" ]; then
            printf '## Review Requests\n\n%s\n' "$reviews"
        else
            printf '## Review Requests\n\n*No pending review requests*\n'
        fi
    } > "$sync_file"

    # Print results
    local task_count=0 review_count=0
    [ -n "$tasks" ] && task_count=$(echo "$tasks" | wc -l)
    [ -n "$reviews" ] && review_count=$(echo "$reviews" | wc -l)

    echo -e "${BOLD}✓ Wrote $task_count tasks + $review_count reviews to Work/GitHub/$today.md${RESET}"
    echo ""
    [ -n "$tasks" ] && echo "$tasks"
    [ -n "$reviews" ] && { echo ""; echo "$reviews"; }

    # Ensure daily note exists (so the transclusion has something to live in)
    ensure_daily_note "$today" > /dev/null

    # Auto-close tasks whose GitHub issue/PR has been resolved
    close_resolved_tasks "$today"
}

# --- Main ---

CMD="${1:-help}"
shift 2>/dev/null || true

case "$CMD" in
    gh|github)
        sync_github
        ;;
    help|--help|-h)
        echo "Usage: task-sync <source>"
        echo ""
        echo "Sources:"
        echo "  gh, github    Sync from GitHub project board"
        ;;
    *)
        echo "Unknown sync source: $CMD"
        echo "Run 'task-sync help' for usage."
        exit 1
        ;;
esac

#!/bin/bash
# Change priority of an Obsidian task
# Usage: task-priority [work|personal|all] [--include-tickler]

set -euo pipefail

VAULT_PATH="$HOME/Documents/Private Sync"
TODAY=$(date +%Y-%m-%d)
FILTER=""
INCLUDE_TICKLER=false

for arg in "$@"; do
    case "$arg" in
        --include-tickler) INCLUDE_TICKLER=true ;;
        *) FILTER="$arg" ;;
    esac
done

find_tasks() {
    grep -rn "^- \[[ /]\] " "$VAULT_PATH" \
        --include="*.md" \
        --exclude-dir=".trash" \
        --exclude-dir=".obsidian" \
        --exclude-dir="Templates" \
        --exclude-dir="Task Workflow Integration" \
        2>/dev/null || true
}

filter_tasks() {
    local tasks="$1"
    case "$FILTER" in
        work|w)
            echo "$tasks" | grep "#context/work" || true
            ;;
        personal|private|p)
            echo "$tasks" | grep -E "#context/(personal|private)" || true
            ;;
        *)
            echo "$tasks"
            ;;
    esac
}

exclude_tickled() {
    if [ "$INCLUDE_TICKLER" = true ]; then
        cat
        return
    fi
    while IFS= read -r line; do
        if [[ "$line" =~ ⏳\ ([0-9]{4}-[0-9]{2}-[0-9]{2}) ]]; then
            [[ "${BASH_REMATCH[1]}" > "$TODAY" ]] && continue
        fi
        echo "$line"
    done
}

format_for_fzf() {
    sed "s|^$VAULT_PATH/||"
}

ALL_TASKS=$(find_tasks)

if [ -z "$ALL_TASKS" ]; then
    echo "📭 No open tasks found"
    exit 0
fi

FILTERED=$(filter_tasks "$ALL_TASKS" | exclude_tickled)

if [ -z "$FILTERED" ]; then
    echo "📭 No matching tasks found"
    exit 0
fi

SELECTED=$(echo "$FILTERED" | format_for_fzf | fzf \
    --prompt="Set priority > " \
    --header="Select task to reprioritize" \
    --preview-window=hidden \
    --no-multi \
    --height=40%) || exit 0

FILE="$VAULT_PATH/$(echo "$SELECTED" | cut -d: -f1)"
LINE_NUM=$(echo "$SELECTED" | cut -d: -f2)

if [ ! -f "$FILE" ]; then
    echo "Error: file not found: $FILE"
    exit 1
fi

# Pick priority
PRIORITY=$(printf "1) 🔺 High\n2) ⏫ Medium\n3) 🔽 Low\n4) None (remove priority)" | fzf \
    --prompt="Priority > " \
    --header="Select priority" \
    --preview-window=hidden \
    --no-multi \
    --height=10%) || exit 0

# Map selection to emoji
case "$PRIORITY" in
    1*) EMOJI="🔺" ;;
    2*) EMOJI="⏫" ;;
    3*) EMOJI="🔽" ;;
    4*) EMOJI="" ;;
esac

ORIGINAL=$(sed -n "${LINE_NUM}p" "$FILE")

# Remove any existing priority emoji
UPDATED=$(echo "$ORIGINAL" | sed 's/ *[🔺⏫🔽]//g')

# Insert priority after the checkbox (before any other metadata)
if [ -n "$EMOJI" ]; then
    UPDATED=$(echo "$UPDATED" | sed "s/^\(- \[[ /]\] [^🔁⏳📅✅#]*\)/\1 $EMOJI/;s/  / /g")
fi

sed -i "${LINE_NUM}s|.*|${UPDATED}|" "$FILE"

TASK_TEXT=$(echo "$UPDATED" | sed 's/^- \[[ /]\] //')
SHORT_FILE=$(echo "$FILE" | sed "s|^$VAULT_PATH/||")
echo "✓ Updated priority: $TASK_TEXT"
echo "  in $SHORT_FILE"

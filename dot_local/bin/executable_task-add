#!/bin/bash
# Quick task capture for Obsidian
# Usage: task-add "Task description" [--priority high|medium|low] [--context|-c work|private|<name>] [--due DATE] [--tickle DATE] [--every INTERVAL]

set -euo pipefail

# Configuration
VAULT_PATH="$HOME/Documents/Private Sync"
INBOX_FILE="$VAULT_PATH/Inbox.md"
DAILY_NOTE_DIR="$VAULT_PATH/Notes/Daily"

# Get today's date and daily note path
TODAY=$(date +%Y-%m-%d)
YEAR=$(date +%Y)
MONTH=$(date +%m)
DAILY_NOTE="$DAILY_NOTE_DIR/$YEAR/$MONTH/$TODAY.md"

# Default values
DESCRIPTION=""
PRIORITY=""
CONTEXT=""
CONTEXT_SET=false
DUE_DATE=""
TICKLE_DATE=""
RECURRENCE=""
TARGET="inbox"  # or "daily"

# Parse arguments
while [[ $# -gt 0 ]]; do
    case $1 in
        --priority|-p)
            case $2 in
                high|urgent|1) PRIORITY="🔺" ;;
                medium|2) PRIORITY="⏫" ;;
                low|3) PRIORITY="🔽" ;;
                *) PRIORITY="" ;;
            esac
            shift 2
            ;;
        --context|-c|-t)
            CONTEXT="$2"
            CONTEXT_SET=true
            shift 2
            ;;
        --due|-d)
            DUE_DATE="$2"
            shift 2
            ;;
        --tickle|--defer)
            TICKLE_DATE="$2"
            shift 2
            ;;
        --every)
            RECURRENCE="$2"
            shift 2
            ;;
        --daily)
            TARGET="daily"
            shift
            ;;
        --inbox)
            TARGET="inbox"
            shift
            ;;
        due:*)
            DUE_DATE="${1#due:}"
            shift
            ;;
        *)
            DESCRIPTION="$1"
            shift
            ;;
    esac
done

# Validate description
if [ -z "$DESCRIPTION" ]; then
    echo "Error: Task description required"
    echo "Usage: task-add \"description\" [--priority high|medium|low] [--context|-c work|private|<name>] [--due DATE]"
    exit 1
fi

# Interactive context selector if not explicitly set
if [ "$CONTEXT_SET" = false ]; then
    if [ -t 0 ]; then
        printf "Context: 1) work  2) private  3) other: "
        read -r choice
        case $choice in
            1|"") CONTEXT="work" ;;
            2) CONTEXT="private" ;;
            *) CONTEXT="$choice" ;;
        esac
    else
        CONTEXT="work"
    fi
fi

# Extract due:DATE from description if not already set via flag
if [ -z "$DUE_DATE" ] && [[ "$DESCRIPTION" =~ due:([^ ]+) ]]; then
    DUE_DATE="${BASH_REMATCH[1]}"
    DESCRIPTION="${DESCRIPTION/due:${BASH_REMATCH[1]}/}"
    DESCRIPTION="$(echo "$DESCRIPTION" | sed 's/  */ /g; s/^ *//; s/ *$//')"
fi

# Resolve relative dates to YYYY-MM-DD
resolve_date() {
    local input="$1"
    case "$input" in
        [0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9])
            echo "$input" ;;
        +[0-9]*d)
            date -d "+${input:1:-1} days" +%Y-%m-%d ;;
        +[0-9]*w)
            date -d "+${input:1:-1} weeks" +%Y-%m-%d ;;
        +[0-9]*m)
            date -d "+${input:1:-1} months" +%Y-%m-%d ;;
        *)
            # Let date(1) try to parse it (handles "today", "tomorrow", "next friday", etc.)
            date -d "$input" +%Y-%m-%d 2>/dev/null || { echo "Error: cannot parse date '$input'" >&2; exit 1; }
            ;;
    esac
}

if [ -n "$DUE_DATE" ]; then
    DUE_DATE=$(resolve_date "$DUE_DATE")
fi
if [ -n "$TICKLE_DATE" ]; then
    TICKLE_DATE=$(resolve_date "$TICKLE_DATE")
fi

# Build task line
TASK="- [ ] $DESCRIPTION"

# Add priority if specified
if [ -n "$PRIORITY" ]; then
    TASK="$TASK $PRIORITY"
fi

# Obsidian Tasks field order: priority, recurrence, dates, tags
# Add recurrence if specified (before dates)
if [ -n "$RECURRENCE" ]; then
    TASK="$TASK 🔁 every $RECURRENCE"
fi

# Add due date if specified
if [ -n "$DUE_DATE" ]; then
    TASK="$TASK 📅 $DUE_DATE"
fi

# Add tickle/scheduled date if specified
if [ -n "$TICKLE_DATE" ]; then
    TASK="$TASK ⏳ $TICKLE_DATE"
fi

# Add context tag
TASK="$TASK #context/$CONTEXT"

# Append to target file
if [ "$TARGET" = "daily" ] && [ -f "$DAILY_NOTE" ]; then
    # Append to daily note (after "## Work" section if it exists)
    if grep -q "^## Work" "$DAILY_NOTE"; then
        # Insert after ## Work heading
        sed -i "/^## Work/a\\
$TASK" "$DAILY_NOTE"
        echo "✓ Added to today's daily note"
    else
        # Append to end
        echo "$TASK" >> "$DAILY_NOTE"
        echo "✓ Added to today's daily note (end of file)"
    fi
elif [ "$TARGET" = "daily" ]; then
    echo "⚠ Daily note doesn't exist yet, adding to inbox instead"
    echo "$TASK" >> "$INBOX_FILE"
    echo "✓ Added to inbox"
else
    # Append to inbox
    echo "$TASK" >> "$INBOX_FILE"
    echo "✓ Added to inbox"
fi

echo "$TASK"

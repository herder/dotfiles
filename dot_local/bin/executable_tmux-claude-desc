#!/bin/bash
# tmux-claude-desc — fold each Claude pane's task into a SESSION-scoped
# @claude_session_desc option so the session picker can show what each session is
# doing. The session NAME is left untouched (a decorated name breaks
# session-wizard's directory-derived create/reuse); choose-tree reads the option
# via its -F format instead. See dot_tmux.conf.tmpl `bind s`.
#
#   tmux-claude-desc capture   # snapshot THIS pane's title -> @claude_desc, refresh its session
#   tmux-claude-desc clear     # drop THIS pane's contribution (Claude exiting), refresh its session
#   tmux-claude-desc refresh   # recompute every session (cleanup after a pane closes)
#
# A pane contributes only via its own @claude_desc pane-option; the session's
# @claude_session_desc is always recomputed from scratch from all contributing
# panes. So panes never clobber each other, and a closed pane drops out
# automatically (its options die with it).

set -euo pipefail

# ── tunables ─────────────────────────────────────────────────────────
# Titles are shown full-length: the picker (choose-tree) has the whole terminal
# width, so no truncation — just clean and join the panes' descriptions.
SEP=' | '        # separator between pane descriptions inside the suffix

[ -z "${TMUX:-}" ] && exit 0

# strip leading status glyph (Claude prefixes a spinner/marker), drop chars that
# would break the "[ a | b ]" format, collapse and trim whitespace.
clean() {
    printf '%s' "$1" | sed -E 's/^[^[:alnum:]]+//; s/[][|]/ /g; s/[[:space:]]+/ /g; s/^ +//; s/ +$//'
}

join_by() { local sep=$1 out=$2; shift 2; printf '%s' "$out"; printf '%s' "${@/#/$sep}"; }

# Rewrite vague issue references ("work on github issue 123") into the
# identifiable "<repo>#<N>: <issue title>" form. Repo comes from the pane cwd's
# origin remote; the title from gh (issue, then PR), cached forever per slug+N
# so the network is hit once per reference. Prints the input unchanged when
# there's nothing to do or the lookup can't resolve a repo.
enrich() {
    local desc=$1 path=$2 num slug repo title cache key
    # already carries a repo#N token — nothing to do
    printf '%s' "$desc" | grep -qE '[A-Za-z0-9_.-]+#[0-9]+' && { printf '%s' "$desc"; return; }
    num=$(printf '%s' "$desc" | grep -oiE '\b(issue|pull request|pr)s? ?#?[0-9]+|#[0-9]+' \
        | grep -oE '[0-9]+' | head -n1) || true
    [ -z "${num:-}" ] && { printf '%s' "$desc"; return; }
    slug=$(git -C "${path:-/}" remote get-url origin 2>/dev/null \
        | sed -E 's#^(git@|ssh://git@|https://)[^/:]+[:/]##; s#\.git$##') || slug=""
    [ -z "$slug" ] && { printf '%s' "$desc"; return; }
    repo=${slug##*/}
    cache=${XDG_CACHE_HOME:-$HOME/.cache}/tmux-claude-desc
    mkdir -p "$cache" 2>/dev/null || true
    key=$cache/${slug//\//_}-$num
    if [ -s "$key" ]; then
        title=$(<"$key")
    else
        title=$(timeout 5 gh issue view "$num" -R "$slug" --json title --jq .title 2>/dev/null) \
            || title=$(timeout 5 gh pr view "$num" -R "$slug" --json title --jq .title 2>/dev/null) \
            || title=""
        [ -n "$title" ] && printf '%s' "$title" >"$key" 2>/dev/null
    fi
    if [ -n "$title" ]; then
        printf '%s#%s: %s' "$repo" "$num" "$(clean "$title")"
    else
        printf '%s#%s: %s' "$repo" "$num" "$desc"
    fi
}

# recompute a session's @claude_session_desc from all its panes' @claude_desc.
refresh_one() {
    local sid=$1

    local descs=() seen="" d
    while IFS= read -r d; do
        [ -z "$d" ] && continue
        case "$seen" in *"|$d|"*) continue ;; esac
        seen="$seen|$d|"
        descs+=("$d")
    done < <(tmux list-panes -s -t "$sid" -F '#{@claude_desc}' 2>/dev/null)

    local suffix=""
    [ "${#descs[@]}" -gt 0 ] && suffix=" [$(join_by "$SEP" "${descs[@]}")]"

    local cur
    cur=$(tmux show-options -t "$sid" -qv @claude_session_desc 2>/dev/null) || cur=""
    [ "$suffix" = "$cur" ] || tmux set-option -t "$sid" @claude_session_desc "$suffix" 2>/dev/null || true
}

refresh_all() {
    local sid
    while IFS= read -r sid; do
        [ -z "$sid" ] && continue
        refresh_one "$sid"
    done < <(tmux list-sessions -F '#{session_id}' 2>/dev/null)
}

capture() {
    local pane=${TMUX_PANE:-}
    [ -z "$pane" ] && exit 0
    local title desc
    title=$(tmux display -p -t "$pane" '#{pane_title}' 2>/dev/null) || exit 0
    desc=$(clean "$title")
    # skip the default "claude: <repo>" placeholder — no real task yet
    case "$desc" in
        claude:*|"") tmux set-option -p -t "$pane" -u @claude_desc 2>/dev/null || true ;;
        *)
            local path enriched
            path=$(tmux display -p -t "$pane" '#{pane_current_path}' 2>/dev/null) || path=""
            enriched=$(enrich "$desc" "$path") || enriched=$desc
            if [ -n "$enriched" ] && [ "$enriched" != "$desc" ]; then
                desc=$enriched
                # push back so the pane-border pill shows it too; Claude Code may
                # overwrite next turn, and the next capture just re-enriches
                tmux select-pane -t "$pane" -T "$desc" 2>/dev/null || true
            fi
            tmux set-option -p -t "$pane" @claude_desc "$desc" ;;
    esac
    local sid
    sid=$(tmux display -p -t "$pane" '#{session_id}') || exit 0
    refresh_one "$sid"
}

clear_pane() {
    local pane=${TMUX_PANE:-}
    [ -z "$pane" ] && exit 0
    tmux set-option -p -t "$pane" -u @claude_desc 2>/dev/null || true
    local sid
    sid=$(tmux display -p -t "$pane" '#{session_id}' 2>/dev/null) || exit 0
    refresh_one "$sid"
}

case "${1:-refresh}" in
    capture) capture ;;
    clear)   clear_pane ;;
    refresh) refresh_all ;;
    *) echo "usage: tmux-claude-desc {capture|clear|refresh}" >&2; exit 2 ;;
esac

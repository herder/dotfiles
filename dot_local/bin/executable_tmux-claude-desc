#!/bin/bash
# tmux-claude-desc — keep each Claude pane's task in its pane-scoped @claude_desc,
# which the pane border, the prefix+s picker (tmux-claude-pick) and the alert jump read.
# Driven by Claude Code hooks (UserPromptSubmit, Stop, SessionEnd).
#
#   tmux-claude-desc capture   # refresh THIS pane's @claude_desc
#   tmux-claude-desc clear     # drop it (Claude exiting)

set -euo pipefail

[ -z "${TMUX:-}" ] && exit 0

# strip leading status glyph (Claude prefixes a spinner/marker), collapse and trim
# whitespace.
clean() {
    printf '%s' "$1" | sed -E 's/^[^[:alnum:]]+//; s/[[:space:]]+/ /g; s/^ +//; s/ +$//'
}

# Rewrite vague issue references ("work on github issue 123") into the
# identifiable "<repo>#<N>: <issue title>" form. Repo comes from the pane cwd's
# origin remote; the title from gh (issue, then PR), cached forever per slug+N
# so the network is hit once per reference. Prints the input unchanged when
# there's nothing to do or the lookup can't resolve a repo.
enrich() {
    local desc=$1 path=$2 num slug repo title cache key
    # already carries a repo#N token — nothing to do
    printf '%s' "$desc" | grep -qE '[A-Za-z0-9_.-]+#[0-9]+' && { printf '%s' "$desc"; return; }
    num=$(printf '%s' "$desc" | grep -oiE '\b(issue|pull request|pr)s? ?#?[0-9]+|#[0-9]+' \
        | grep -oE '[0-9]+' | head -n1) || true
    [ -z "${num:-}" ] && { printf '%s' "$desc"; return; }
    slug=$(git -C "${path:-/}" remote get-url origin 2>/dev/null \
        | sed -E 's#^(git@|ssh://git@|https://)[^/:]+[:/]##; s#\.git$##') || slug=""
    [ -z "$slug" ] && { printf '%s' "$desc"; return; }
    repo=${slug##*/}
    cache=${XDG_CACHE_HOME:-$HOME/.cache}/tmux-claude-desc
    mkdir -p "$cache" 2>/dev/null || true
    key=$cache/${slug//\//_}-$num
    if [ -s "$key" ]; then
        title=$(<"$key")
    else
        title=$(timeout 5 gh issue view "$num" -R "$slug" --json title --jq .title 2>/dev/null) \
            || title=$(timeout 5 gh pr view "$num" -R "$slug" --json title --jq .title 2>/dev/null) \
            || title=""
        [ -n "$title" ] && printf '%s' "$title" >"$key" 2>/dev/null
    fi
    if [ -n "$title" ]; then
        printf '%s#%s: %s' "$repo" "$num" "$(clean "$title")"
    else
        printf '%s#%s: %s' "$repo" "$num" "$desc"
    fi
}

# Claude's latest aiTitle for the live session in this pane, from its transcript.
ai_title() {
    local pane=$1 pid uuid t
    while read -r pid uuid; do
        [ -d "/proc/$pid" ] || continue
        for t in "$HOME"/.claude/projects/*/"$uuid".jsonl; do
            [ -r "$t" ] || continue
            tac "$t" | grep -m1 -oE '"aiTitle":"[^"]+"' | sed -E 's/^"aiTitle":"(.*)"$/\1/'
            return
        done
    done < <(PATH="$HOME/.local/share/mise/shims:$PATH" jq -r --arg p ".$pane" \
        'select(.tmux and (.tmux | endswith($p))) | "\(.pid) \(.sessionId)"' \
        "$HOME"/.claude/sessions/*.json 2>/dev/null)
}

# Best description first: a claimed worktree's task line (written on purpose; the
# session started in the main checkout, so locks, not cwd); Claude's pane title; its
# transcript aiTitle when the title is a placeholder ("claude: <repo>" from
# SessionStart, generic "Claude Code"). Nothing usable keeps the old one; only
# SessionEnd clears.
capture() {
    local pane=${TMUX_PANE:-}
    [ -z "$pane" ] && exit 0
    local desc path
    desc=$("$HOME/.local/bin/claude-pane-worktrees" "$pane" 2>/dev/null | cut -f4) || desc=""
    desc=$(clean "$desc")
    if [ -z "$desc" ]; then
        desc=$(clean "$(tmux display -p -t "$pane" '#{pane_title}' 2>/dev/null)")
        case "$desc" in claude:*|"Claude Code") desc=$(clean "$(ai_title "$pane")") ;; esac
        case "$desc" in claude:*|"Claude Code") desc="" ;; esac
        if [ -n "$desc" ]; then
            path=$(tmux display -p -t "$pane" '#{pane_current_path}' 2>/dev/null) || path=""
            desc=$(enrich "$desc" "$path") || true
        fi
    fi
    [ -z "$desc" ] || tmux set-option -p -t "$pane" @claude_desc "$desc"
}

clear_pane() {
    local pane=${TMUX_PANE:-}
    [ -z "$pane" ] && exit 0
    tmux set-option -p -t "$pane" -u @claude_desc 2>/dev/null || true
}

case "${1:-}" in
    capture) capture ;;
    clear)   clear_pane ;;
    *) echo "usage: tmux-claude-desc {capture|clear}" >&2; exit 2 ;;
esac

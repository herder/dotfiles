{{ if not .work }}
# Work tooling: the standup summary reads Stravito GitHub activity and posts to
# the Stravito Slack. A personal machine must not be able to do either.
.local/bin/gh-standup
.config/systemd/user/gh-standup.service
.config/systemd/user/gh-standup.timer

# Pairs with .chezmoiscripts/linux/run_onchange_after_install_aws_vpn.sh.tmpl.
.local/share/applications/awsvpnclient.desktop
{{ end }}

{{ if ne .chezmoi.hostname "sobchak" }}
# Pairs with .chezmoiscripts/linux/run_onchange_after_enable_nas_raid_check_timer.sh.tmpl.
.local/bin/nas-raid-check
.config/systemd/user/nas-raid-check.service
.config/systemd/user/nas-raid-check.timer
{{ end }}

{{ if .headless }}
# Pairs with .chezmoiscripts/linux/run_onchange_after_enable_ollama.sh.tmpl.
.config/systemd/user/ollama.service
{{ end }}

[".config/zsh/.antidote"]
  type = "git-repo"
  url = "https://github.com/mattmc3/antidote"
  refreshPeriod = "168h"
[".intellimacs"]
  type = "git-repo"
  url = "https://github.com/MarcoIeni/intellimacs"
  refreshPeriod = "168h"
[".local/bin/wtf"]
  type = "archive-file"
  url = {{ gitHubLatestReleaseAssetURL "wtfutil/wtf" (printf "wtf_*_%s_%s.tar.gz" .chezmoi.os .chezmoi.arch) | quote }}
  executable = true
  path = "wtfutil"
[".local/bin/starship"]
  type = "archive-file"
  {{- if eq .chezmoi.os "linux"}}
  url = "https://github.com/starship/starship/releases/latest/download/starship-x86_64-unknown-linux-gnu.tar.gz"
  {{- end }}
  executable = true
  path = "starship"
[".local/bin/atuin"]

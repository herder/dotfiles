  {{- if eq .chezmoi.os "linux"}}
  url = "https://github.com/atuinsh/atuin/releases/latest/download/atuin-x86_64-unknown-linux-gnu.tar.gz"
  {{- end }}
  executable = true
  stripComponents = 1
  path = "atuin"
[".local/bin/bob"]

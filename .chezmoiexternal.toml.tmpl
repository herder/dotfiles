[".config/zsh/.antidote"]
  type = "git-repo"
  url = "https://github.com/mattmc3/antidote"
  refreshPeriod = "168h"
[".intellimacs"]
  type = "git-repo"
  url = "https://github.com/MarcoIeni/intellimacs"
  refreshPeriod = "168h"

# CLI binaries live in ~/.config/mise/config.toml; only non-binaries and the
# docker CLI plugin (which docker looks up by path) stay here.
[".docker/cli-plugins/docker-mcp"]
  type = "archive-file"
  url = {{ (printf "https://github.com/docker/mcp-gateway/releases/download/%s/docker-mcp-%s-%s.tar.gz" ((gitHubLatestTag "docker/mcp-gateway").Name | toString ) .chezmoi.os .chezmoi.arch ) | quote }}
  executable = true
  path = "docker-mcp"

# Wonderbrushed — hand-drawn freedesktop icon theme (CC-BY-SA-4.0).
# Select it in COSMIC via ~/.config/cosmic/com.system76.CosmicTk/v1/icon_theme,
# which keys on the *directory* name ("Wonderbrushed"), not index.theme's Name=.
# Inherits=breeze-dark,hicolor — both present on Pop, so fallbacks resolve.
# Upstream does not flag betas as prereleases, so /releases/latest (what
# gitHubLatestReleaseAssetURL uses) tracks beta tags too. Zip is ~237MB and
# growing fast (66→103→237MB over three releases), hence the 30-day refresh.
# exclude drops the shipped source art and a stray editor backup file.
{{- if and (eq .chezmoi.os "linux") (not .ephemeral) (not .headless) }}
[".local/share/icons/Wonderbrushed"]
  type = "archive"
  url = {{ gitHubLatestReleaseAssetURL "Bhavneeth-Games/Wonderbrushed" "Wonderbrushed.zip" | quote }}
  refreshPeriod = "720h"
  stripComponents = 1
  exclude = ["**/Original Files/**", "**/*~"]
{{- end }}

# Mattermost Desktop — Electron tarball (~128MB), replaces the flathub install.
# Upstream ships no .desktop file (only create_desktop_file.sh, which hardcodes an
# absolute path); dot_local/share/applications/Mattermost.desktop.tmpl does that job.
# chrome-sandbox is setuid-root in the tarball but extracts unprivileged — Electron
# falls back to the userns sandbox, which Pop 24.04 permits (no apparmor userns
# restriction sysctl). If that ever changes, the symptom is a SUID-sandbox error.
# Lives under .local/share (a managed parent) rather than .local/opt, which chezmoi
# refuses to create: "mkdir .local/opt: no such file or directory".
{{- if and (eq .chezmoi.os "linux") (not .ephemeral) (not .headless) }}
[".local/share/mattermost-desktop"]
  type = "archive"
  url = {{ gitHubLatestReleaseAssetURL "mattermost/desktop" "mattermost-desktop-*-linux-x64.tar.gz" | quote }}
  refreshPeriod = "168h"
  stripComponents = 1
{{- end }}

# Note: ~/.claude is intentionally NOT a chezmoi external. It's a standalone
# checkout of claude-private, managed solely by its own auto-commit hook
# (auto-commit-memory.sh) and SessionStart asset bootstrap (setup-assets.sh).
# chezmoi must not write into it. Fresh-machine bootstrap is handled once by
# .chezmoiscripts/run_once_install_claude_private.sh (clone-if-absent), never
# re-pulled — that re-pull is what made an external clobber the live tree.

{{- if and (not .ephemeral) (not .headless) }}
{{-   $fontDir := "" }}
{{-   if eq .chezmoi.os "darwin" }}
{{-     $fontDir = "Library/Fonts" }}
{{-   else if eq .chezmoi.os "linux" }}
{{-     $fontDir = ".local/share/fonts" }}
{{-   end }}
{{-   range (list
        "IosevkaTerm"
        "JetBrainsMono"
        "CascadiaCode") }}
["{{ $fontDir }}/{{ . }}"]
    url = {{ printf "https://github.com/ryanoasis/nerd-fonts/releases/latest/download/%s.zip" . | quote }}
    type = "archive"
    include = ["*.ttf"]
    refreshPeriod = "168h"
{{-   end }}
{{- end }}


#compdef task-priority

# Zsh completion for task-priority

_task-priority() {
  _arguments -C \
    '1:filter:((work\:"Show only work tasks" w\:"Work (short)" personal\:"Show only personal tasks" p\:"Personal (short)" all\:"Show all tasks"))' \
    '--include-tickler[Include future tickler tasks]'
}

_task-priority "$@"

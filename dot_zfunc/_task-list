#compdef task-list

# Zsh completion for task-list

_task-list() {
  local -a modes
  modes=(
    'today:Show today'\''s tasks (default)'
    't:Show today'\''s tasks (short)'
    'all:Show all tasks (today + inbox)'
    'a:Show all tasks (short)'
    'work:Show only work tasks'
    'w:Show only work tasks (short)'
    'personal:Show only personal tasks'
    'p:Show only personal tasks (short)'
    'context:Show tasks by context tag'
    'c:Show tasks by context tag (short)'
  )

  _describe 'mode' modes
}

_task-list "$@"

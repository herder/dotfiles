#compdef task-add

# Zsh completion for task-add

_task-add() {
  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '1:task description:' \
    '(-p --priority)'{-p,--priority}'[Task priority]:priority:(high urgent medium low)' \
    '(-c -t --context)'{-c,-t,--context}'[Task context]:context:(work private personal)' \
    '(-d --due)'{-d,--due}'[Due date]:date:' \
    '--tickle[Scheduled/tickle date]:date:' \
    '--every[Recurrence interval]:interval:(day week "2 weeks" month "3 months" "6 months" year)' \
    '--daily[Add to daily note instead of inbox]' \
    '--inbox[Add to inbox (default)]'
}

_task-add "$@"

#compdef task-done

# Zsh completion for task-done

_task-done() {
  local -a filters
  filters=(
    'work:Show only work tasks'
    'w:Show only work tasks (short)'
    'personal:Show only personal tasks'
    'p:Show only personal tasks (short)'
    'all:Show all tasks (default)'
  )

  _describe 'filter' filters
}

_task-done "$@"
